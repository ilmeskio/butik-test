---
/**
 * Button — pilot component for the @butik/ui catalogue.
 *
 * CSS Modules + tokens from @butik/ui-tokens (ADR-0005). No Tailwind, no raw
 * values where a token exists. Renders as <a> when `href` is set, else <button>.
 */
import styles from './Button.module.css';

interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', type = 'button' } = Astro.props;
const cls = `${styles.button} ${styles[variant]}`;
---

{
  href ? (
    <a class={cls} href={href}>
      <slot />
    </a>
  ) : (
    <button class={cls} type={type}>
      <slot />
    </button>
  )
}
