---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const servizi = await getCollection('servizi', e => !e.data.draft);
  return servizi.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  heroImage={entry.data.heroImage}
  heroAlt={entry.data.heroAlt}
  metaTitle={entry.data.metaTitle}
  metaDescription={entry.data.metaDescription}
  ogImage={entry.data.ogImage?.src}
  transitionName={`servizio-${entry.id}`}
>
  <Content />
</ContentLayout>
