---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import CtaBanner from '../../components/CtaBanner.astro';

const servizi = (await getCollection('servizi', e => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const metodo = [
  {
    title: 'Ascolto attivo',
    description: 'Ogni progetto parte dalla ricerca sul campo per capire i bisogni reali di comunità, istituzioni e operatori.',
  },
  {
    title: 'Co-progettazione',
    description: 'Costruiamo le soluzioni insieme ai partner territoriali, senza importarle dall\'esterno.',
  },
  {
    title: 'Protagonismo giovanile',
    description: 'Le nuove generazioni non sono un target dei nostri progetti, sono parte attiva dei processi.',
  },
  {
    title: 'Formazione immersiva ed esperienziale',
    description: 'Il nostro modello formativo è basato sull\'esperienza diretta e sulla costruzione di una comunità temporanea di progetto.',
  },
  {
    title: 'Eventi come strumento strategico',
    description: 'Progettiamo format che attivano territori e generano impatto sociale.',
  },
];
---

<BaseLayout
  title="Servizi — Butik"
  description="Scopri i servizi di Butik: progettazione culturale, consulenza strategica, formazione, eventi e sviluppo turistico su base musicale."
>
  <!-- Page header -->
  <div class="max-w-4xl mx-auto px-6 pt-20 md:pt-24 pb-12 text-center">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">Cosa facciamo</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-6">Servizi</h1>
    <p class="font-sans text-base md:text-lg text-butik-body leading-relaxed">
      Ogni territorio ha un patrimonio musicale unico e spesso poco valorizzato. Lavoriamo con
      Pubbliche Amministrazioni, enti territoriali, operatori culturali e turistici per attivarlo:
      dalla progettazione alla formazione, dagli eventi allo sviluppo turistico.
    </p>
    <p class="font-sans text-base md:text-lg text-butik-body leading-relaxed mt-4">
      I nostri progetti sono costruiti su misura, a partire dall'ascolto dei bisogni e dall'analisi
      del contesto. A questo si affiancano <strong class="font-bold text-butik-dark">format proprietari</strong>
      già collaudati, attivabili e adattabili a diversi territori e necessità.
    </p>
  </div>

  <!-- Grid -->
  <section class="max-w-7xl mx-auto px-6 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {servizi.map((s, i) => (
        <a href={`/servizi/${s.id}`} class="group block">
          <div class="overflow-hidden mb-5">
            <Image
              src={s.data.heroImage}
              alt={s.data.heroAlt}
              widths={[400, 700]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              quality={72}
              loading={i < 3 ? 'eager' : 'lazy'}
              class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500"
              transition:name={`servizio-${s.id}`}
            />
          </div>
          <h2 class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2" transition:name={`servizio-${s.id}-title`}>
            {s.data.title}
          </h2>
          <p class="font-sans text-base text-butik-body leading-relaxed" transition:name={`servizio-${s.id}-subtitle`}>
            {s.data.subtitle}
          </p>
          <span class="mt-4 inline-block font-display text-xs font-bold tracking-widest uppercase text-butik-dark border-b-2 border-butik-red pb-0.5 group-hover:text-butik-red transition-colors">
            Scopri di più →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Il nostro metodo -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-10 md:mb-12">
        <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">Come lavoriamo</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-butik-dark">Il nostro metodo</h2>
      </div>
      <ul class="space-y-6">
        {metodo.map((m, i) => (
          <li class="flex gap-4 md:gap-5">
            <span class="inline-flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-butik-red font-display text-sm font-bold text-white">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-1">
              <p class="metodo-title font-heading text-base md:text-lg font-bold text-butik-dark leading-snug">{m.title}</p>
              <p class="font-sans text-sm md:text-base text-butik-dark/70 leading-relaxed mt-1">{m.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA finale -->
  <CtaBanner
    title="Vuoi vedere i nostri servizi in azione?"
    primaryCta={{ label: 'Visiona il nostro portfolio', href: '/progetti' }}
    secondaryCta={{ label: 'Scopri i nostri format', href: '/formats' }}
  />
</BaseLayout>

<style>
  .metodo-title {
    text-transform: none;
    letter-spacing: -0.005em;
    color: var(--color-butik-dark);
  }
</style>
