---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const servizi = (await getCollection('servizi', e => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Servizi — Butik"
  description="Scopri i servizi di Butik: progettazione culturale, turismo musicale e sviluppo territoriale."
>
  <!-- Page header -->
  <div class="pt-20 pb-12 text-center">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">Cosa facciamo</p>
    <h1 class="font-heading text-5xl font-bold text-butik-dark">Servizi</h1>
  </div>

  <!-- Grid -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {servizi.map(s => (
        <a href={`/servizi/${s.id}`} class="group block">
          <div class="overflow-hidden mb-5">
            <Image
              src={s.data.heroImage}
              alt={s.data.heroAlt}
              widths={[400, 700]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              quality={72}
              class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <h2 class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">
            {s.data.title}
          </h2>
          <p class="font-sans text-base text-butik-body leading-relaxed">
            {s.data.subtitle}
          </p>
          <span class="mt-4 inline-block font-display text-xs font-bold tracking-widest uppercase text-butik-dark border-b-2 border-butik-red pb-0.5 group-hover:text-butik-red transition-colors">
            Scopri di più →
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
