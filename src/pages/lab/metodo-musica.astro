---
// ── Lab — Studi "Metodo a tema musica" ────────────────────────────────────
// Pagina interna NON linkata in nav (raggiungibile via /lab/metodo-musica).
// Quattro studi che arricchiscono l'area metodo con grafiche/animazioni a tema
// musica, riusando la libreria motion. NON sostituiscono la versione in home
// (src/components/home/Metodo.astro): sono materiale di esplorazione.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetodoOnde from '../../components/home/metodo-variants/musica/MetodoOnde.astro';
import MetodoVinili from '../../components/home/metodo-variants/musica/MetodoVinili.astro';
import MetodoTraccia from '../../components/home/metodo-variants/musica/MetodoTraccia.astro';
import MetodoBattito from '../../components/home/metodo-variants/musica/MetodoBattito.astro';

const studi = [
  {
    n: 1,
    label: 'Connettori = onde sonore',
    nota: 'I trattini tra le tappe diventano una waveform che scorre. Connettore a elemento singolo: linea sempre allineata al centro dei nodi.',
    Comp: MetodoOnde,
  },
  {
    n: 2,
    label: 'Nodi = vinili che ruotano',
    nota: 'Ogni cerchio è un disco con solchi e riflesso; l’icona è l’etichetta centrale. All’hover il disco accelera.',
    Comp: MetodoVinili,
  },
  {
    n: 3,
    label: 'Timeline = traccia DAW',
    nota: 'Le 5 tappe come una traccia audio: righello, clip con mini-waveform e playhead che scorre. Pannello scuro stile editor.',
    Comp: MetodoTraccia,
  },
  {
    n: 4,
    label: 'Connettori = battito',
    nota: 'Filo a trattini che scorre con un bollo che viaggia “a tempo”; anelli che pulsano dietro i nodi come una membrana.',
    Comp: MetodoBattito,
  },
];
---

<BaseLayout
  title="Lab — Studi Metodo a tema musica"
  description="Pagina interna di esplorazione: grafiche e animazioni a tema musica per l'area Metodo."
>
  <div class="pt-20 pb-8 text-center">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
      Pagina interna · lab
    </p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark">
      Studi — Metodo a tema musica
    </h1>
    <p class="font-sans text-sm text-butik-dark/60 mt-4 max-w-2xl mx-auto px-6">
      Quattro esplorazioni per arricchire l’area metodo con la firma musicale del
      brand. Materiale di studio: la versione in home resta invariata.
    </p>
  </div>

  {
    studi.map(({ n, label, nota, Comp }) => (
      <>
        <div class="border-t border-butik-dark/10">
          <div class="max-w-7xl mx-auto px-6 pt-10 flex flex-wrap items-center gap-3">
            <span class="inline-block font-display text-xs font-bold tracking-widest uppercase text-white bg-butik-red rounded-full px-4 py-1.5">
              Studio {n} — {label}
            </span>
            <span class="font-sans text-sm text-butik-dark/60 max-w-xl">{nota}</span>
          </div>
        </div>
        <Comp />
      </>
    ))
  }
</BaseLayout>
