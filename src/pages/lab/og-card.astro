---
// LAB — prototipo card OG (Open Graph) generate dinamicamente a build-time.
// Obiettivo: card "Reddit-style" che anticipa il contenuto della pagina + CTA
// scelta per-pagina. Qui sono mockup HTML/CSS a dimensione reale (1200×630),
// scalati per stare a video. Sono disegnati "Satori-friendly" (solo flexbox e
// CSS basilare) così il porting al generatore di build sarà quasi 1:1.
import BaseLayout from '#layouts/BaseLayout.astro';
import bolloRosso from '#assets/logos/bollo-rosso.svg';
import bolloNero from '#assets/logos/bollo-nero.svg';
// Hero di un progetto, per le varianti che usano l'immagine.
import heroDemo from '#assets/progetti/template-progetto/hero.jpg';

// Tipi di pagina coperti: progetto, servizio, pagina statica.
// Ogni esempio porta la PROPRIA cta → dimostra l'override per-pagina.
interface CardData {
  kind: string;        // "eyebrow": tipo/categoria mostrato in alto
  title: string;
  subtitle: string;
  meta?: string[];     // metadati (progetti: cliente · anno · categoria)
  cta: string;         // call-to-action scelta dalla pagina
  url: string;         // dominio/handle mostrato in basso
}

const esempi: CardData[] = [
  {
    kind: 'Progetto · Eventi e Format',
    title: 'TUM — Festival del Turismo Musicale',
    subtitle:
      'Format di attivazione territoriale per valorizzare e raccontare il patrimonio musicale di una città.',
    meta: ['Milano · Cremona · Napoli · Pesaro', '2024'],
    cta: 'Scopri il progetto',
    url: '@wearebutik',
  },
  {
    kind: 'Servizio',
    title: 'Progettazione culturale',
    subtitle:
      'Disegniamo progetti culturali finanziabili: dall’idea al bando, fino alla rendicontazione.',
    cta: 'Richiedi una consulenza',
    url: '@wearebutik',
  },
  {
    kind: 'Butik · Impresa sociale',
    title: 'Cultura e territori attraverso la musica',
    subtitle:
      'La prima impresa sociale italiana specializzata in progettazione culturale e sviluppo territoriale attraverso la musica.',
    cta: 'Parliamone',
    url: '@wearebutik',
  },
];
---

<BaseLayout
  title="Lab — Card OG"
  description="Prototipo delle card Open Graph generate a build-time: due direzioni di design + CTA per-pagina."
>
  <style>
    /* Ogni card è renderizzata a 1200×630 reali, poi scalata via CSS per
       stare nella pagina. Lo wrapper "stage" riserva l'altezza scalata così
       il layout non collassa. 0.5 = metà = 600×315 a video. */
    .og-stage {
      width: 600px;
      height: 315px;
      overflow: hidden;
    }
    .og-card {
      width: 1200px;
      height: 630px;
      transform: scale(0.5);
      transform-origin: top left;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
    }

    /* ── Variante A · Editoriale chiaro ───────────────────────────── */
    .v-light {
      background-color: #fff2f1;
      padding: 72px 80px;
      justify-content: space-between;
    }
    .v-light .eyebrow {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 28px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #e21929;
    }
    .v-light .title {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 72px;
      line-height: 1;
      color: #071108;
      margin: 0;
    }
    .v-light .subtitle {
      font-family: 'Clear Sans', sans-serif;
      font-size: 32px;
      line-height: 1.35;
      color: #071108;
      opacity: 0.88;
      margin-top: 20px;
      max-width: 920px;
      /* max 2 righe + ellissi: tiene l'altezza prevedibile (supportato anche da Satori) */
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .v-light .meta {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 24px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #071108;
      opacity: 0.7;
      margin-top: 18px;
    }

    /* ── Variante B · Notturno ────────────────────────────────────── */
    .v-dark {
      background-color: #071108;
      padding: 72px 80px;
      justify-content: space-between;
    }
    .v-dark .eyebrow {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 28px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #d2ff28;
    }
    .v-dark .title {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 72px;
      line-height: 1;
      color: #fff2f1;
      margin: 0;
    }
    .v-dark .subtitle {
      font-family: 'Clear Sans', sans-serif;
      font-size: 32px;
      line-height: 1.35;
      color: #fff2f1;
      opacity: 0.9;
      margin-top: 20px;
      max-width: 920px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .v-dark .meta {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 24px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fff2f1;
      opacity: 0.6;
      margin-top: 18px;
    }

    /* Riga inferiore comune: handle a sinistra, CTA pill a destra */
    .footer-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .handle {
      display: flex;
      align-items: center;
    }
    .handle img {
      width: 64px;
      height: 64px;
    }
    .handle .url {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 30px;
      letter-spacing: 0.04em;
      margin-left: 20px;
    }
    .v-light .handle .url { color: #071108; }
    .v-dark .handle .url { color: #fff2f1; }

    .cta {
      display: flex;
      align-items: center;
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 32px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 22px 40px;
      border-radius: 999px;
    }
    .v-light .cta { background-color: #e21929; color: #fff2f1; }
    .v-dark .cta { background-color: #d2ff28; color: #071108; }
    .cta .arrow { margin-left: 16px; }

    .head-row { display: flex; align-items: flex-start; flex-direction: column; }

    /* ── Variante C · Split (testo + immagine) ────────────────────── */
    .v-split {
      flex-direction: row;
      background-color: #fff2f1;
    }
    .v-split .pane {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 1;
      padding: 56px 56px;
      box-sizing: border-box;
    }
    .v-split .shot {
      width: 444px;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    /* pannello logo (variante home) al posto della foto */
    .v-split .logo-pane {
      width: 444px;
      height: 100%;
      background-color: #071108;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .v-split .logo-pane img { width: 224px; height: 224px; }
    .v-split .title { font-size: 60px; }
    .v-split .subtitle { -webkit-line-clamp: 3; max-width: none; }

    /* ── Variante D · Full-bleed + scrim ──────────────────────────── */
    .v-bleed { position: relative; padding: 0; }
    .v-bleed .bg {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .v-bleed .scrim {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background-image: linear-gradient(
        to top,
        rgba(7, 17, 8, 0.94) 0%,
        rgba(7, 17, 8, 0.55) 42%,
        rgba(7, 17, 8, 0.12) 100%
      );
    }
    .v-bleed .content {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      height: 100%;
      padding: 64px 72px;
    }
    .v-bleed .eyebrow {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 26px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #d2ff28;
    }
    .v-bleed .title {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 76px;
      line-height: 1;
      color: #fff2f1;
      margin: 16px 0 0;
    }
    .v-bleed .meta {
      font-family: 'League Spartan', sans-serif;
      font-weight: 700;
      font-size: 22px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fff2f1;
      opacity: 0.7;
      margin-top: 16px;
    }
    .v-bleed .footer-row { margin-top: 36px; }
    .v-bleed .handle .url { color: #fff2f1; }
    .v-bleed .cta { background-color: #e21929; color: #fff2f1; }
  </style>

  <section class="max-w-5xl mx-auto px-6 pt-24 pb-8">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-3">
      Interno · prototipo
    </p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-4">
      Card OG — anteprima
    </h1>
    <p class="font-sans text-base md:text-lg text-butik-body max-w-2xl leading-relaxed">
      Card in stile “anteprima discussione” (à la Reddit): tipo di pagina, titolo grande,
      sottotitolo, metadati e una <strong>call-to-action scelta dalla singola pagina</strong>.
      Ogni card è a dimensione reale <strong>1200×630</strong>, mostrata qui a metà scala.
      Due direzioni a confronto — chiara e notturna. Una volta scelta, la cablo nel
      generatore di build (Satori) così viene prodotta automaticamente per ogni pagina.
    </p>
  </section>

  <!-- Variante A · chiara -->
  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">
      Variante A
    </p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-6">
      Editoriale chiaro
    </h2>
    <div class="flex flex-wrap gap-8">
      {esempi.map((c) => (
        <div class="og-stage">
          <div class="og-card v-light">
            <div class="head-row">
              <p class="eyebrow">{c.kind}</p>
              <h3 class="title" style="margin-top:20px">{c.title}</h3>
              <p class="subtitle">{c.subtitle}</p>
              {c.meta && <p class="meta">{c.meta.join('  ·  ')}</p>}
            </div>
            <div class="footer-row">
              <div class="handle">
                <img src={bolloRosso.src} alt="" />
                <span class="url">{c.url}</span>
              </div>
              <div class="cta">{c.cta}<span class="arrow">→</span></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Variante B · notturna -->
  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">
      Variante B
    </p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-6">
      Notturno
    </h2>
    <div class="flex flex-wrap gap-8">
      {esempi.map((c) => (
        <div class="og-stage">
          <div class="og-card v-dark">
            <div class="head-row">
              <p class="eyebrow">{c.kind}</p>
              <h3 class="title" style="margin-top:20px">{c.title}</h3>
              <p class="subtitle">{c.subtitle}</p>
              {c.meta && <p class="meta">{c.meta.join('  ·  ')}</p>}
            </div>
            <div class="footer-row">
              <div class="handle">
                <img src={bolloNero.src} alt="" />
                <span class="url">{c.url}</span>
              </div>
              <div class="cta">{c.cta}<span class="arrow">→</span></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Variante C · Split (testo + immagine) -->
  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">
      Variante C · con immagine
    </p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">
      Split — testo + hero
    </h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl leading-relaxed mb-6">
      L’hero del progetto fa da “thumbnail” a destra. Adatta alle pagine che hanno
      un’immagine (i progetti). Servizi e pagine senza hero ricadono sulla A.
    </p>
    <div class="flex flex-wrap gap-8">
      {[esempi[0]].map((c) => (
        <div class="og-stage">
          <div class="og-card v-split v-light">
            <div class="pane">
              <div class="head-row">
                <p class="eyebrow">{c.kind}</p>
                <h3 class="title" style="margin-top:16px">{c.title}</h3>
                <p class="subtitle">{c.subtitle}</p>
                {c.meta && <p class="meta">{c.meta.join('  ·  ')}</p>}
              </div>
              <div class="footer-row">
                <div class="handle">
                  <img src={bolloRosso.src} alt="" />
                  <span class="url">{c.url}</span>
                </div>
                <div class="cta">{c.cta}<span class="arrow">→</span></div>
              </div>
            </div>
            <img class="shot" src={heroDemo.src} alt="" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Variante home · Split + logo -->
  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">
      Variante home · adottata
    </p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">
      Split + logo
    </h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl leading-relaxed mb-6">
      Per la home: testo a sinistra, pannello brand col bollo a destra (al posto
      della foto). Scelta in produzione: <strong>home → questa</strong>, progetti →
      Full-bleed, servizi e altre pagine → Editoriale chiaro.
    </p>
    <div class="flex flex-wrap gap-8">
      {[esempi[2]].map((c) => (
        <div class="og-stage">
          <div class="og-card v-split v-light">
            <div class="pane">
              <div class="head-row">
                <p class="eyebrow">{c.kind}</p>
                <h3 class="title" style="margin-top:16px">{c.title}</h3>
                <p class="subtitle">{c.subtitle}</p>
                {c.meta && <p class="meta">{c.meta.join('  ·  ')}</p>}
              </div>
              <div class="footer-row">
                <div class="handle">
                  <img src={bolloRosso.src} alt="" />
                  <span class="url">{c.url}</span>
                </div>
                <div class="cta">{c.cta}<span class="arrow">→</span></div>
              </div>
            </div>
            <div class="logo-pane"><img src={bolloRosso.src} alt="" /></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Variante D · Full-bleed + scrim -->
  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">
      Variante D · con immagine
    </p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">
      Full-bleed + scrim
    </h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl leading-relaxed mb-6">
      Immagine a tutta card, gradiente scuro in basso, titolo e CTA sopra. Massimo
      impatto “social”. Il sottotitolo si omette per non affollare.
    </p>
    <div class="flex flex-wrap gap-8">
      {[esempi[0]].map((c) => (
        <div class="og-stage">
          <div class="og-card v-bleed">
            <img class="bg" src={heroDemo.src} alt="" />
            <div class="scrim"></div>
            <div class="content">
              <p class="eyebrow">{c.kind}</p>
              <h3 class="title">{c.title}</h3>
              {c.meta && <p class="meta">{c.meta.join('  ·  ')}</p>}
              <div class="footer-row">
                <div class="handle">
                  <img src={bolloRosso.src} alt="" />
                  <span class="url">{c.url}</span>
                </div>
                <div class="cta">{c.cta}<span class="arrow">→</span></div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
