---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/home/Hero.astro';
import PartnerLogos from '../components/home/PartnerLogos.astro';
import Numbers from '../components/home/Numbers.astro';
import Testimonials from '../components/home/Testimonials.astro';
import PortfolioGrid from '../components/home/PortfolioGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import AboutInline from '../components/home/AboutInline.astro';
import Metodo from '../components/home/Metodo.astro';
import NewsletterSignup from '../components/home/NewsletterSignup.astro';

const topProgetti = (await getCollection('progetti', e => e.data.featured && !e.data.draft))
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder)
  .slice(0, 4);
---

<BaseLayout
  title="Butik — Music Tourism in Italy"
  description="La prima impresa sociale italiana specializzata in progettazione culturale e sviluppo territoriale attraverso la musica."
>
  <Hero />
  <PartnerLogos />
  <Numbers />
  <Metodo />
  <Testimonials />
  <PortfolioGrid progetti={topProgetti} />
  <CtaBanner
    title="Lavoriamo insieme?"
    body="Che tu sia un Comune, una DMO, un operatore culturale o un festival, siamo pronti ad ascoltarti e costruire qualcosa insieme."
    primaryCta={{ label: 'Contattaci', href: '/contatti' }}
    secondaryCta={{ label: 'Scopri i servizi', href: '/servizi' }}
  />
  <AboutInline />
  <CtaBanner
    title="Cerchi una consulenza su misura o vuoi replicare uno dei nostri format sul tuo territorio?"
    primaryCta={{ label: 'Scopri tutti i nostri servizi', href: '/servizi' }}
    secondaryCta={{ label: 'Scopri i nostri format', href: '/formats' }}
  />
  <NewsletterSignup />
</BaseLayout>
