---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logo from '../assets/logos/bollo-rosso.svg';
import { getAllOgCards, ogPngPathForRoute, normalizeRoute } from '../data/ogCards';

const optimizedOg = await getImage({ src: logo, width: 1200, format: 'png' });

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Butik',
  description = 'La prima impresa sociale italiana specializzata in progettazione culturale e sviluppo territoriale attraverso la musica.',
  ogImage,
} = Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);

// og:image — precedenza: override esplicito della pagina > card generata per
// questa rotta > logo di fallback. Sempre come URL assoluto.
const route = normalizeRoute(Astro.url.pathname);
const ogCards = await getAllOgCards();
const ogCard = ogImage ? null : ogCards.get(route);
const hasCard = ogCard != null;
const ogImagePath = ogImage ?? (hasCard ? ogPngPathForRoute(route) : optimizedOg.src);
const ogImageURL = new URL(ogImagePath, siteBase).href;
// width/height/type valgono solo per le card generate (1200×630 PNG):
// per il logo di fallback la proporzione è diversa, meglio non dichiararli.
const ogImageAlt = ogCard ? `${ogCard.title} — Butik` : title;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload font per spezzare la catena CSS → font -->
    <link rel="preload" href="/fonts/league-spartan-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clear-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clear-sans-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Butik" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {hasCard && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image:alt" content={ogImageAlt} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
