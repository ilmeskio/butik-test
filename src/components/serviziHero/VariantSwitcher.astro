---
// Interruttore discreto per passare tra l'hero ATTUALE e le varianti A/B/C
// dello STESSO servizio. Fisso in basso a destra, volutamente poco invadente:
// serve al team Butik per confrontare le direzioni dal vivo finché il sito
// non è ufficiale. Presente sia sulla pagina reale che sui prototipi.
interface Props {
  current: 'orig' | 'a' | 'b' | 'c';
  slug: string;
}
const { current, slug } = Astro.props;
const varianti: Array<'a' | 'b' | 'c'> = ['a', 'b', 'c'];
---

<div class="variant-switcher" aria-label="Anteprima varianti hero servizio">
  <span class="variant-switcher__label">Hero</span>
  <a
    href={`/servizi/${slug}`}
    class:list={['variant-switcher__orig', current === 'orig' && 'is-active']}
    aria-current={current === 'orig' ? 'true' : undefined}
  >
    Attuale
  </a>
  <div class="variant-switcher__group">
    {varianti.map((v) => (
      <a
        href={`/servizi-hero-${v}/${slug}`}
        class:list={['variant-switcher__btn', v === current && 'is-active']}
        aria-current={v === current ? 'true' : undefined}
      >
        {v.toUpperCase()}
      </a>
    ))}
  </div>
  <a href="/servizi-hero" class="variant-switcher__hub">tutte →</a>
</div>

<style>
  .variant-switcher {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    background: color-mix(in srgb, var(--color-butik-dark) 88%, transparent);
    color: #fff;
    border-radius: 999px;
    box-shadow: 0 6px 24px rgba(7, 17, 8, 0.28);
    opacity: 0.42;
    transition: opacity 160ms ease;
    backdrop-filter: blur(4px);
  }
  .variant-switcher:hover,
  .variant-switcher:focus-within {
    opacity: 1;
  }
  .variant-switcher__label {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .variant-switcher__orig {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .variant-switcher__orig:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .variant-switcher__group {
    display: flex;
    gap: 0.25rem;
  }
  .variant-switcher__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fff;
    text-decoration: none;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .variant-switcher__btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .variant-switcher__orig.is-active,
  .variant-switcher__btn.is-active {
    background: var(--color-butik-red);
    color: #fff;
  }
  .variant-switcher__orig:focus-visible,
  .variant-switcher__btn:focus-visible {
    outline: 2px solid var(--color-butik-green);
    outline-offset: 2px;
  }
  .variant-switcher__hub {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    padding-right: 0.25rem;
  }
  .variant-switcher__hub:hover {
    color: var(--color-butik-green);
  }
  @media (prefers-reduced-motion: reduce) {
    .variant-switcher {
      transition: none;
    }
  }
</style>
