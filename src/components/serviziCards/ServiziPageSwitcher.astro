---
// Switcher discreto per confrontare le direzioni della pagina /servizi.
interface Props {
  current: 'orig' | 'a' | 'b' | 'c';
}
const { current } = Astro.props;
const varianti: Array<'a' | 'b' | 'c'> = ['a', 'b', 'c'];
---

<div class="sp-switcher" aria-label="Anteprima direzioni pagina servizi">
  <span class="sp-switcher__label">Servizi</span>
  <a href="/servizi" class:list={['sp-switcher__btn sp-switcher__btn--wide', current === 'orig' && 'is-active']} aria-current={current === 'orig' ? 'true' : undefined}>Attuale</a>
  {varianti.map((v) => (
    <a href={`/servizi-${v}`} class:list={['sp-switcher__btn', v === current && 'is-active']} aria-current={v === current ? 'true' : undefined}>
      {v.toUpperCase()}
    </a>
  ))}
</div>

<style>
  .sp-switcher {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    background: color-mix(in srgb, var(--color-butik-dark) 88%, transparent);
    color: #fff;
    border-radius: 999px;
    box-shadow: 0 6px 24px rgba(7, 17, 8, 0.28);
    opacity: 0.42;
    transition: opacity 160ms ease;
    backdrop-filter: blur(4px);
  }
  .sp-switcher:hover,
  .sp-switcher:focus-within {
    opacity: 1;
  }
  .sp-switcher__label {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .sp-switcher__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    transition: background-color 140ms ease;
  }
  .sp-switcher__btn--wide {
    width: auto;
    padding: 0 0.7rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sp-switcher__btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .sp-switcher__btn.is-active {
    background: var(--color-butik-red);
  }
  .sp-switcher__btn:focus-visible {
    outline: 2px solid var(--color-butik-green);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-switcher {
      transition: none;
    }
  }
</style>
