---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata | string;
  imageAlt?: string;
  transitionName?: string;
}

const { title, subtitle, image, imageAlt = '', transitionName } = Astro.props;
---

<section class="relative h-[70vh] min-h-[400px] flex items-end overflow-hidden">
  <div class="absolute inset-0">
    {typeof image === 'string' ? (
      <img src={image} alt={imageAlt} class="w-full h-full object-cover" transition:name={transitionName} />
    ) : (
      <Image src={image} alt={imageAlt} class="w-full h-full object-cover" widths={[800, 1200, 1600]} sizes="100vw" quality={72} transition:name={transitionName} />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 w-full">
    <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight max-w-3xl" transition:name={transitionName && `${transitionName}-title`}>
      {title}
    </h1>
    {subtitle && (
      <p class="mt-4 font-sans text-lg md:text-xl text-white/80 max-w-2xl" transition:name={transitionName && `${transitionName}-subtitle`}>
        {subtitle}
      </p>
    )}
  </div>
</section>
