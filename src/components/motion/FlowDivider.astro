---
// Divisore a trattini che "scorrono" + un bollo che viaggia lungo la linea.
// Alternativa alla waveform per separare le sezioni. Richiama i connettori
// tratteggiati del "metodo".
interface Props {
  tone?: 'onLight' | 'onDark';
  speed?: number; // secondi
  dot?: boolean; // bollo viaggiante
  class?: string;
}
const { tone = 'onLight', speed = 3, dot = true, class: cls = '' } = Astro.props;
---

<div class:list={['flow', `flow--${tone}`, cls]} style={`--flow-speed:${speed}s`} aria-hidden="true">
  <span class="flow__line"></span>
  {dot && <span class="flow__bollo"></span>}
</div>

<style>
  .flow {
    position: relative;
    width: 100%;
    height: 12px;
    display: flex;
    align-items: center;
    --flow-c: color-mix(in srgb, var(--color-butik-dark) 45%, transparent);
    --flow-dot: var(--color-butik-red);
  }
  .flow--onDark {
    --flow-c: rgba(255, 255, 255, 0.4);
    --flow-dot: var(--color-butik-green);
  }
  .flow__line {
    width: 100%;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--flow-c) 0 9px,
      transparent 9px 18px
    );
    background-size: 18px 2px;
    animation: flow-move var(--flow-speed, 3s) linear infinite;
  }
  .flow__bollo {
    position: absolute;
    top: 50%;
    left: 0;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--flow-dot);
    animation: flow-travel calc(var(--flow-speed, 3s) * 2.4) linear infinite;
  }
  @keyframes flow-move {
    to { background-position-x: 18px; }
  }
  @keyframes flow-travel {
    0% { left: 0; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow__line,
    .flow__bollo { animation: none; }
    .flow__bollo { display: none; }
  }
</style>
