---
// Onda sonora animata che scorre in orizzontale (loop continuo).
// Usabile come divisore di sezione, sotto i titoli, o accento di banner.
interface Props {
  tone?: 'onLight' | 'onDark' | 'red' | 'green';
  height?: number; // px
  speed?: number; // secondi per ciclo
  class?: string;
}
const { tone = 'onLight', height = 56, speed = 6, class: cls = '' } = Astro.props;

// Genera un'onda sinusoidale (quadratiche) larga 1200, con periodo 160px
// (due segmenti su/giù) così lo scorrimento di -160px è perfettamente in loop.
const W = 1200;
const SEG = 80;
const AMP = 14;
const MID = 30;
let d = `M0 ${MID}`;
let up = true;
for (let x = 0; x < W; x += SEG) {
  const cx = x + SEG / 2;
  const cy = up ? MID - AMP : MID + AMP;
  const ex = x + SEG;
  d += ` Q ${cx} ${cy} ${ex} ${MID}`;
  up = !up;
}
---

<div class:list={['wave', `wave--${tone}`, cls]} style={`--wave-h:${height}px; --wave-speed:${speed}s`} aria-hidden="true">
  <svg viewBox="0 0 600 60" preserveAspectRatio="none">
    <g class="wave__g">
      <path d={d} />
    </g>
  </svg>
</div>

<style>
  .wave {
    width: 100%;
    height: var(--wave-h, 56px);
    overflow: hidden;
    color: var(--wave-c, var(--color-butik-red));
  }
  .wave--onLight { --wave-c: var(--color-butik-red); }
  .wave--onDark { --wave-c: var(--color-butik-green); }
  .wave--red { --wave-c: var(--color-butik-red); }
  .wave--green { --wave-c: var(--color-butik-green); }

  .wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .wave__g path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .wave__g {
    animation: wave-scroll var(--wave-speed, 6s) linear infinite;
  }
  @keyframes wave-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-160px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave__g { animation: none; }
  }
</style>
