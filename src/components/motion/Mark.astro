---
// Segni grafici da spruzzare per dare carattere editoriale: spark, croce,
// mirino, bollo, sparkle. Twinkle opzionale (pulsa/ruota piano).
interface Props {
  type?: 'spark' | 'plus' | 'reg' | 'bollo' | 'sparkle';
  color?: 'red' | 'green' | 'dark' | 'purple';
  size?: number; // px
  twinkle?: boolean;
  class?: string;
}
const { type = 'spark', color = 'red', size = 24, twinkle = false, class: cls = '' } = Astro.props;

const filled = type === 'spark' || type === 'bollo' || type === 'sparkle';
const paths: Record<string, string> = {
  spark: '<path d="M12 1 L14.2 9.8 L23 12 L14.2 14.2 L12 23 L9.8 14.2 L1 12 L9.8 9.8 Z"/>',
  sparkle: '<path d="M12 2 Q13 11 22 12 Q13 13 12 22 Q11 13 2 12 Q11 11 12 2 Z"/>',
  bollo: '<circle cx="12" cy="12" r="8"/>',
  plus: '<path d="M12 3 V21 M3 12 H21"/>',
  reg: '<circle cx="12" cy="12" r="7"/><path d="M12 2 V6 M12 18 V22 M2 12 H6 M18 12 H22"/>',
};
---

<span
  class:list={['mark', `mark--${color}`, twinkle && 'mark--twinkle', cls]}
  style={`--mark-size:${size}px`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 24 24"
    fill={filled ? 'currentColor' : 'none'}
    stroke={filled ? 'none' : 'currentColor'}
    stroke-width="2"
    stroke-linecap="round"
    set:html={paths[type]}
  />
</span>

<style>
  .mark {
    display: inline-flex;
    width: var(--mark-size, 24px);
    height: var(--mark-size, 24px);
    color: var(--mark-c, var(--color-butik-red));
  }
  .mark svg { width: 100%; height: 100%; display: block; }
  .mark--red { --mark-c: var(--color-butik-red); }
  .mark--green { --mark-c: var(--color-butik-green); }
  .mark--dark { --mark-c: var(--color-butik-dark); }
  .mark--purple { --mark-c: var(--color-butik-purple); }

  .mark--twinkle svg {
    animation: mark-twinkle 2.4s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes mark-twinkle {
    0%, 100% { transform: scale(0.82) rotate(0deg); opacity: 0.7; }
    50% { transform: scale(1) rotate(45deg); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark--twinkle svg { animation: none; }
  }
</style>
