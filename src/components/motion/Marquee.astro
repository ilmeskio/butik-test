---
// Marquee tipografico cinetico (stile poster musicale): testo che scorre.
// Usabile come fascia di transizione tra sezioni, claim ricorrente, footer-hook.
interface Props {
  items: string[];
  tone?: 'onLight' | 'onDark';
  reverse?: boolean;
  speed?: number; // secondi per ciclo
  class?: string;
}
const { items, tone = 'onDark', reverse = false, speed = 22, class: cls = '' } = Astro.props;
// Duplico la lista per il loop continuo (-50%).
const loop = [...items, ...items];
---

<div class:list={['mq', `mq--${tone}`, cls]} aria-hidden="true">
  <div class:list={['mq__track', reverse && 'mq__track--rev']} style={`--mq-speed:${speed}s`}>
    {loop.map((it) => (
      <span class="mq__item">
        {it}
        <span class="mq__dot">●</span>
      </span>
    ))}
  </div>
</div>

<style>
  .mq {
    width: 100%;
    overflow: hidden;
    padding: 0.4em 0;
  }
  .mq--onDark {
    background: var(--color-butik-dark);
    color: #fff;
  }
  .mq--onLight {
    color: var(--color-butik-dark);
  }
  .mq__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: mq-scroll var(--mq-speed, 22s) linear infinite;
  }
  .mq__track--rev {
    animation-direction: reverse;
  }
  .mq:hover .mq__track {
    animation-play-state: paused;
  }
  .mq__item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .mq__dot {
    color: var(--color-butik-red);
    font-size: 0.5em;
  }
  .mq--onDark .mq__dot {
    color: var(--color-butik-green);
  }
  @keyframes mq-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq__track { animation: none; }
  }
</style>
