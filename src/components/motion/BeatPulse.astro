---
// Beat pulse — anelli concentrici che si espandono come la membrana di un
// altoparlante. Usabile dietro un'icona, su una CTA "live", o come segnale
// "in corso". Al centro un punto pieno; gli anelli pulsano in loop.
interface Props {
  tone?: 'red' | 'green' | 'dark';
  size?: number; // px del punto centrale
  class?: string;
}
const { tone = 'red', size = 14, class: cls = '' } = Astro.props;
---

<span class:list={['beat', `beat--${tone}`, cls]} style={`--beat-size:${size}px`} aria-hidden="true">
  <i class="beat__ring"></i>
  <i class="beat__ring"></i>
  <i class="beat__ring"></i>
  <span class="beat__dot"></span>
</span>

<style>
  .beat {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--beat-size, 14px);
    height: var(--beat-size, 14px);
    color: var(--beat-c, var(--color-butik-red));
  }
  .beat--red { --beat-c: var(--color-butik-red); }
  .beat--green { --beat-c: var(--color-butik-green); }
  .beat--dark { --beat-c: var(--color-butik-dark); }

  .beat__dot {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: currentColor;
  }
  .beat__ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 2px solid currentColor;
    opacity: 0;
    animation: beat-pulse 2s ease-out infinite;
  }
  .beat__ring:nth-child(2) { animation-delay: 0.66s; }
  .beat__ring:nth-child(3) { animation-delay: 1.33s; }

  @keyframes beat-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(3.4); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .beat__ring { animation: none; }
  }
</style>
