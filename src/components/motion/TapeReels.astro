---
// Bobine (mangianastri) che girano — accento-firma musicale/nostalgico.
// Due rulli collegati da un nastro; i rulli ruotano in loop.
interface Props {
  size?: number; // px diametro rullo
  tone?: 'onLight' | 'onDark';
  speed?: number; // secondi/giro
  class?: string;
}
const { size = 40, tone = 'onLight', speed = 3, class: cls = '' } = Astro.props;
---

<span
  class:list={['reels', `reels--${tone}`, cls]}
  style={`--reel-size:${size}px; --reel-speed:${speed}s`}
  aria-hidden="true"
>
  <span class="reels__reel"><i></i><i></i><i></i></span>
  <span class="reels__tape"></span>
  <span class="reels__reel"><i></i><i></i><i></i></span>
</span>

<style>
  .reels {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--reel-size, 40px) * 0.55);
    --reel-c: var(--color-butik-dark);
  }
  .reels--onDark { --reel-c: #fff; }

  .reels__reel {
    position: relative;
    width: var(--reel-size, 40px);
    height: var(--reel-size, 40px);
    border-radius: 50%;
    border: 2px solid var(--reel-c);
    animation: reel-spin var(--reel-speed, 3s) linear infinite;
  }
  /* mozzo centrale */
  .reels__reel::after {
    content: '';
    position: absolute;
    inset: 38%;
    border-radius: 50%;
    background: var(--color-butik-red);
  }
  /* tre razze */
  .reels__reel i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 46%;
    background: var(--reel-c);
    transform-origin: 50% 0;
    transform: translate(-50%, 0) rotate(var(--rot, 0deg));
  }
  .reels__reel i:nth-child(1) { --rot: 0deg; }
  .reels__reel i:nth-child(2) { --rot: 120deg; }
  .reels__reel i:nth-child(3) { --rot: 240deg; }

  .reels__tape {
    height: 2px;
    width: calc(var(--reel-size, 40px) * 0.7);
    background: var(--reel-c);
    opacity: 0.5;
  }
  @keyframes reel-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reels__reel { animation: none; }
  }
</style>
