---
// Disco in vinile che ruota — accento-firma musicale (alternativo all'equalizer).
// Usabile accanto a un titolo, come loader, o decoro d'angolo. Gira più veloce
// all'hover del contenitore.
interface Props {
  size?: number; // px
  label?: 'red' | 'green' | 'dark';
  speed?: number; // secondi/giro
  class?: string;
}
const { size = 64, label = 'red', speed = 6, class: cls = '' } = Astro.props;
---

<span
  class:list={['vinyl', `vinyl--${label}`, cls]}
  style={`--vinyl-size:${size}px; --vinyl-speed:${speed}s`}
  aria-hidden="true"
>
  <span class="vinyl__disc">
    <span class="vinyl__label"><span class="vinyl__hole"></span></span>
    <span class="vinyl__sheen"></span>
  </span>
</span>

<style>
  .vinyl {
    display: inline-block;
    width: var(--vinyl-size, 64px);
    height: var(--vinyl-size, 64px);
  }
  .vinyl__disc {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle at center, #0c0c0c 0 1.5px, #1d1d1d 1.5px 3px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), 0 8px 20px -8px rgba(7, 17, 8, 0.5);
    animation: vinyl-spin var(--vinyl-speed, 6s) linear infinite;
  }
  .vinyl:hover .vinyl__disc {
    animation-duration: calc(var(--vinyl-speed, 6s) / 3);
  }
  .vinyl__label {
    position: absolute;
    inset: 34%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
  }
  .vinyl--red .vinyl__label { background: var(--color-butik-red); }
  .vinyl--green .vinyl__label { background: var(--color-butik-green); }
  .vinyl--dark .vinyl__label { background: var(--color-butik-dark); }
  .vinyl__hole {
    width: 14%;
    height: 14%;
    min-width: 3px;
    min-height: 3px;
    border-radius: 50%;
    background: #fff;
  }
  /* riflesso obliquo statico, non ruota col disco */
  .vinyl__sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.16) 0 18%, transparent 38%);
    pointer-events: none;
  }
  @keyframes vinyl-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vinyl__disc { animation: none; }
  }
</style>
