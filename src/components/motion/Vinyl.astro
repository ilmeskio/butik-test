---
// Disco in vinile che ruota — accento-firma musicale (alternativo all'equalizer).
// Usabile accanto a un titolo, come loader, o decoro d'angolo. Gira da solo;
// all'hover si "scratcha": il disco segue il mouse come sotto la mano del dj e,
// al rilascio, mantiene la velocità del lancio rallentando per inerzia fino al
// giro di regime (logica e parametri TAU/MAX_VEL/STALE in #lib/motion/vinylScratch).
interface Props {
  size?: number; // px
  label?: 'red' | 'green' | 'dark';
  speed?: number; // secondi/giro
  class?: string;
}
const { size = 64, label = 'red', speed = 6, class: cls = '' } = Astro.props;
---

<span
  class:list={['vinyl', `vinyl--${label}`, cls]}
  style={`--vinyl-size:${size}px; --vinyl-speed:${speed}s`}
  aria-hidden="true"
>
  <span class="vinyl__disc">
    <span class="vinyl__glint"></span>
    <span class="vinyl__label"><span class="vinyl__hole"></span></span>
  </span>
</span>

<style>
  .vinyl {
    position: relative;
    display: inline-block;
    width: var(--vinyl-size, 64px);
    height: var(--vinyl-size, 64px);
    cursor: grab;
    touch-action: none;
  }
  .vinyl:active { cursor: grabbing; }
  .vinyl__disc {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle at center, #0c0c0c 0 1.5px, #1d1d1d 1.5px 3px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), 0 8px 20px -8px rgba(7, 17, 8, 0.5);
    /* fallback no-JS: spin a velocità fissa. Con JS la rotazione (e l'inerzia
       dello scratch) è guidata da requestAnimationFrame, che disattiva questa. */
    animation: vinyl-spin var(--vinyl-speed, 6s) linear infinite;
  }
  /* riflesso luminoso che gira col disco: è il segnale di moto (i solchi
     concentrici sono simmetrici e da soli non mostrano la rotazione) e dà
     la lucidità del vinile. Due lobi opposti, come la luce su un disco vero. */
  .vinyl__glint {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
    background: conic-gradient(
      from -55deg,
      rgba(255, 255, 255, 0.6) 0deg,
      rgba(255, 255, 255, 0.05) 26deg,
      transparent 60deg,
      transparent 150deg,
      rgba(255, 255, 255, 0.38) 180deg,
      rgba(255, 255, 255, 0.03) 206deg,
      transparent 240deg,
      transparent 360deg
    );
  }
  .vinyl__label {
    position: absolute;
    inset: 34%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
    pointer-events: none;
  }
  .vinyl--red .vinyl__label { background: var(--color-butik-red); }
  .vinyl--green .vinyl__label { background: var(--color-butik-green); }
  .vinyl--dark .vinyl__label { background: var(--color-butik-dark); }
  .vinyl__hole {
    width: 14%;
    height: 14%;
    min-width: 3px;
    min-height: 3px;
    border-radius: 50%;
    background: #fff;
  }
  @keyframes vinyl-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vinyl__disc { animation: none; }
  }
</style>

<script>
  import { initVinylScratch } from '#lib/motion/vinylScratch';

  initVinylScratch({
    nodeSelector: '.vinyl',
    discSelector: '.vinyl__disc',
    speedVar: '--vinyl-speed',
    defaultSpeed: 6,
  });
</script>
