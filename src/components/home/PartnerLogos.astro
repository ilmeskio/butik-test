---
type Partner = {
  name: string;
  logo?: string;
};

interface Props {
  partners?: Partner[];
}

const defaultPartners: Partner[] = [
  { name: 'Comune di Milano' },
  { name: 'Milano Music Week' },
  { name: 'Visit Cremona' },
  { name: 'DMO Cremona' },
  { name: 'GAL Terre di Murgia' },
  { name: 'Comune di Napoli' },
  { name: 'Scuola Open Source' },
  { name: 'Mundi Festival' },
  { name: 'Cariplo' },
  { name: 'Italia Music Export' },
];

const { partners = defaultPartners } = Astro.props;

// Duplichiamo la lista nel markup per consentire il loop continuo con translateX(-50%).
const track = [...partners, ...partners];
---

<section class="bg-butik-light py-10 md:py-12 overflow-hidden">
  <div
    class="flex w-max gap-10 md:gap-16 animate-butik-marquee will-change-transform"
    aria-hidden="true"
  >
    {
      track.map((partner) => (
        <div class="shrink-0 border border-butik-dark/20 px-6 py-3 text-xs font-display tracking-widest uppercase text-butik-dark/40">
          {partner.name}
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  @keyframes butik-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-butik-marquee {
    animation: butik-marquee 35s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-butik-marquee {
      animation: none;
    }
  }
</style>
