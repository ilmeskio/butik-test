---
import { Image } from 'astro:assets';
import { partners as defaultPartners, type Partner } from '../../data/partners';

interface Props {
  partners?: Partner[];
}

const { partners = defaultPartners } = Astro.props;

// Duplichiamo la lista nel markup per consentire il loop continuo con translateX(-50%).
const track = [...partners, ...partners];
---

<section
  class="partner-strip relative bg-butik-light pt-10 md:pt-12 pb-14 md:pb-16 overflow-hidden"
  data-partner-strip
>
  <div
    class="flex w-max items-center gap-6 md:gap-8 animate-butik-marquee will-change-transform"
  >
    {
      track.map((partner) => (
        <div
          class="shrink-0 flex items-center justify-center bg-white rounded-xl ring-1 ring-butik-dark/5 px-6 md:px-8 h-16 md:h-20"
          data-name={partner.name}
        >
          <Image
            src={partner.logo}
            alt=""
            height={40}
            densities={[1, 2]}
            loading="eager"
            decoding="async"
            class="max-h-8 md:max-h-10 w-auto"
          />
        </div>
      ))
    }
  </div>

  <p
    class="pointer-events-none absolute inset-x-0 bottom-4 text-center font-display text-xs font-bold tracking-widest uppercase text-butik-dark/60 opacity-0 transition-opacity duration-200"
    data-partner-label
    aria-hidden="true"
  >
  </p>
</section>

<style is:global>
  @keyframes butik-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-butik-marquee {
    animation: butik-marquee 45s linear infinite;
  }

  /* On hover della strip: il marquee si ferma. */
  .partner-strip:hover .animate-butik-marquee {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-butik-marquee {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-partner-strip]').forEach((strip) => {
    const label = strip.querySelector<HTMLElement>('[data-partner-label]');
    const track = strip.querySelector<HTMLElement>('.animate-butik-marquee');

    // Pausa del marquee su hover della strip (oltre alla regola CSS :hover).
    strip.addEventListener('mouseenter', () => {
      if (track) track.style.animationPlayState = 'paused';
    });
    strip.addEventListener('mouseleave', () => {
      if (track) track.style.animationPlayState = 'running';
      if (label) label.style.opacity = '0';
    });

    if (!label) return;

    // Nome del partner in basso alla strip, su hover della singola card.
    strip.querySelectorAll<HTMLElement>('[data-name]').forEach((card) => {
      const name = card.dataset.name ?? '';
      card.addEventListener('mouseenter', () => {
        label.textContent = name;
        label.style.opacity = '1';
      });
    });
  });
</script>
