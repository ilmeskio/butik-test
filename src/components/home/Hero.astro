---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import imgA from '../../assets/servizi/template-servizio/gallery-1.jpg';
import imgB from '../../assets/servizi/template-servizio/img-right.jpg';
import imgC from '../../assets/servizi/template-servizio/hero.jpg';
import imgD from '../../assets/servizi/template-servizio/img-block.jpg';
import imgE from '../../assets/servizi/template-servizio/img-left.jpg';
import imgF from '../../assets/servizi/template-servizio/gallery-3.jpg';
import imgG from '../../assets/servizi/template-servizio/gallery-2.jpg';
import imgH from '../../assets/hero-home.jpg';

interface ScatterSlot {
  /** Set di immagini che ruotano in questa cella. Almeno 1. */
  images: { src: ImageMetadata; alt: string }[];
  /** Classi Tailwind di posizionamento desktop su griglia 8×6. */
  desktop: string;
  /** Velocità parallasse (0 = fermo, >0 = scrolla più lento di pagina). */
  parallax: number;
}

// Composizione "scatter" desktop ispirata al wireframe Relume (col1-1).
// Griglia 8 colonne × 6 righe, testo H1+CTA al centro (col 3-6, row 2-5).
// 8 slot occupano gli angoli e i lati per riempire più area dello scatter.
// Ogni slot ha 2 immagini che si alternano in fade ogni ~5s.
const slots: ScatterSlot[] = [
  // Top row
  { images: [{ src: imgA, alt: 'Workshop di co-progettazione' },
             { src: imgG, alt: 'Percorso di formazione' }],
    desktop: 'md:col-start-1 md:col-span-2 md:row-start-1 md:row-span-2', parallax: 0.18 },
  { images: [{ src: imgB, alt: 'Comunità coinvolta da un progetto' },
             { src: imgH, alt: 'Evento culturale Butik' }],
    desktop: 'md:col-start-7 md:col-span-2 md:row-start-1 md:row-span-2', parallax: 0.12 },

  // Mid sides (colonne laterali piene)
  { images: [{ src: imgC, alt: 'Itinerario turistico-musicale' },
             { src: imgE, alt: 'Formazione e capacity building' }],
    desktop: 'md:col-start-1 md:col-span-2 md:row-start-3 md:row-span-2', parallax: 0.28 },
  { images: [{ src: imgD, alt: 'Concerto e attivazione territoriale' },
             { src: imgF, alt: 'Mappa turistico-musicale' }],
    desktop: 'md:col-start-7 md:col-span-2 md:row-start-3 md:row-span-2', parallax: 0.22 },

  // Bottom row (più ampi, vicino al CTA)
  { images: [{ src: imgE, alt: 'Formazione e capacity building' },
             { src: imgA, alt: 'Workshop di co-progettazione' }],
    desktop: 'md:col-start-1 md:col-span-3 md:row-start-5 md:row-span-2', parallax: 0.32 },
  { images: [{ src: imgF, alt: 'Mappa turistico-musicale' },
             { src: imgD, alt: 'Concerto e attivazione territoriale' }],
    desktop: 'md:col-start-6 md:col-span-3 md:row-start-5 md:row-span-2', parallax: 0.26 },
];

// Immagini mobile (slideshow di sfondo): riusiamo le prime di ogni slot per varietà.
const mobileBackgrounds = slots.map((s) => s.images[0]);
---

<section class="hero relative bg-butik-light overflow-hidden -mt-20 md:mt-0" data-hero-section>

  <!-- MOBILE: immagini di sfondo che ruotano. Nascoste da md: -->
  <div class="absolute inset-0 md:hidden" aria-hidden="true">
    {mobileBackgrounds.map((item, i) => (
      <div
        class:list={[
          'hero-bg-mobile absolute inset-0 transition-opacity duration-1000 ease-in-out',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        data-hero-bg-mobile={i}
      >
        <Image
          src={item.src}
          alt=""
          widths={[480, 768]}
          sizes="100vw"
          quality={70}
          loading={i === 0 ? 'eager' : 'lazy'}
          class="w-full h-full object-cover"
        />
      </div>
    ))}
    <!-- Overlay scuro per garantire leggibilità del testo bianco -->
    <div class="absolute inset-0 bg-butik-dark/65"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-butik-dark/40 via-transparent to-butik-dark/50"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 md:px-8 pt-32 pb-24 md:pt-12 md:pb-12 min-h-[88vh] md:min-h-0 flex md:block items-center">

    <!-- Layout desktop: grid 8×6 con immagini ai lati e testo al centro -->
    <div class="w-full md:grid md:grid-cols-8 md:grid-rows-6 md:gap-3 md:min-h-[680px] lg:min-h-[760px]">

      {slots.map((slot, slotIndex) => (
        <div
          class:list={[
            'hidden md:block relative overflow-hidden will-change-transform',
            slot.desktop,
          ]}
          data-hero-slot={slotIndex}
          data-parallax={slot.parallax}
        >
          {slot.images.map((img, i) => (
            <div
              class:list={[
                'hero-bg-desktop absolute inset-0 transition-opacity duration-[1200ms] ease-in-out',
                i === 0 ? 'opacity-100' : 'opacity-0',
              ]}
              data-hero-bg-desktop={i}
            >
              <Image
                src={img.src}
                alt={i === 0 ? img.alt : ''}
                widths={[300, 500, 700]}
                sizes="(max-width: 768px) 0px, 25vw"
                quality={72}
                loading={slotIndex < 2 && i === 0 ? 'eager' : 'lazy'}
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>
      ))}

      <!-- Blocco centrale H1 + sottotitolo + CTA -->
      <div
        class="relative flex flex-col items-center text-center md:col-start-3 md:row-start-2 md:col-span-4 md:row-span-4 md:justify-center md:px-4"
      >
        <h1
          class="hero-title font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] max-w-3xl mx-auto"
        >
          Attiviamo territori, comunità e nuove generazioni attraverso la musica
        </h1>

        <p
          class="hero-subtitle font-sans text-base md:text-lg mt-6 max-w-2xl mx-auto"
        >
          Dal 2018 progettiamo cultura, formazione ed esperienze turistiche su base
          musicale, al fianco di Comuni, DMO e operatori culturali.
        </p>

        <div class="mt-8 md:mt-10 w-full md:w-auto">
          <a
            href="/contatti"
            class="inline-flex items-center justify-center w-full md:w-auto bg-butik-red md:bg-butik-dark text-white px-8 py-4 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-dark md:hover:bg-butik-red transition-colors"
          >
            Inizia il tuo progetto con noi
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Colori e text-shadow gestiti qui per evitare conflitti di precedenza
     tra utility Tailwind text-white / text-butik-dark al breakpoint md. */
  .hero-title,
  .hero-subtitle {
    color: #ffffff;
    text-shadow: 0 2px 16px rgba(7, 17, 8, 0.6);
  }
  .hero-subtitle {
    opacity: 0.95;
  }
  @media (min-width: 768px) {
    .hero-title {
      color: var(--color-butik-dark);
      text-shadow: none;
    }
    .hero-subtitle {
      color: var(--color-butik-dark);
      opacity: 0.7;
      text-shadow: none;
    }
  }
</style>

<script>
  // ── 1. Slideshow mobile (immagini di sfondo) ───────────────────────────
  const mobileBgs = Array.from(
    document.querySelectorAll<HTMLElement>('.hero-bg-mobile[data-hero-bg-mobile]')
  );
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mobileBgs.length > 1 && !reducedMotion) {
    let current = 0;
    setInterval(() => {
      mobileBgs[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % mobileBgs.length;
      mobileBgs[current].classList.replace('opacity-0', 'opacity-100');
    }, 5000);
  }

  // ── 2. Rotazione fade per ogni slot desktop ────────────────────────────
  const slots = Array.from(
    document.querySelectorAll<HTMLElement>('[data-hero-slot]')
  );
  if (slots.length && !reducedMotion) {
    slots.forEach((slot, i) => {
      const imgs = Array.from(
        slot.querySelectorAll<HTMLElement>('.hero-bg-desktop[data-hero-bg-desktop]')
      );
      if (imgs.length < 2) return;
      let cur = 0;
      // Sfasiamo l'inizio di ogni slot per evitare flash sincroni.
      setTimeout(() => {
        setInterval(() => {
          imgs[cur].classList.replace('opacity-100', 'opacity-0');
          cur = (cur + 1) % imgs.length;
          imgs[cur].classList.replace('opacity-0', 'opacity-100');
        }, 6000);
      }, i * 900);
    });
  }

  // ── 3. Parallasse su scroll per gli slot desktop ───────────────────────
  const desktopMQ = window.matchMedia('(min-width: 768px)');
  let ticking = false;
  let heroRect: DOMRect | null = null;
  const heroSection = document.querySelector<HTMLElement>('[data-hero-section]');

  const updateParallax = () => {
    if (!heroSection || !desktopMQ.matches || reducedMotion) {
      slots.forEach((s) => { s.style.transform = ''; });
      ticking = false;
      return;
    }
    heroRect = heroSection.getBoundingClientRect();
    // Solo se la hero è (parzialmente) visibile
    if (heroRect.bottom < 0 || heroRect.top > window.innerHeight) {
      ticking = false;
      return;
    }
    const progress = -heroRect.top; // pixel scrollati dentro la hero
    slots.forEach((slot) => {
      const speed = parseFloat(slot.dataset.parallax || '0');
      const translateY = progress * speed;
      slot.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0)`;
    });
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateParallax);
    }
  };

  if (heroSection) {
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateParallax();
  }
</script>
