---
// ── Studio musica 2 — Nodi = vinili che ruotano ───────────────────────────
// Ogni tappa è un disco in vinile (solchi + riflesso) che gira lentamente;
// l'etichetta centrale rossa porta l'icona line-style; il badge numerato resta
// sopra. All'hover il disco accelera. Connettore: trattini singoli, allineati.
import { tappe } from '../../../../data/metodo';
import MetodoIcon from '../../MetodoIcon.astro';
---

<section class="bg-white py-12 md:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
        Come lavoriamo
      </p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-butik-dark">
        Il nostro metodo
      </h2>
    </div>

    <ol class="vini">
      {
        tappe.map((tappa, i) => (
          <li class="vini-step">
            <div class="vini-node">
              <span class="vini-disc" aria-hidden="true">
                <span class="vini-sheen"></span>
              </span>
              <span class="vini-label">
                <MetodoIcon name={tappa.icon} size={26} class="vini-icon" />
              </span>
              <span class="vini-num font-display">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="vini-content">
              <h3 class="vini-title font-heading text-lg font-bold text-butik-dark">
                {tappa.title}
              </h3>
              <p class="font-sans text-sm text-butik-dark/70 leading-relaxed mt-1">
                {tappa.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .vini {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vini-node {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* disco: solchi concentrici + ombra */
  .vini-disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle at center,
      #0c0c0c 0 1.6px,
      #1f1f1f 1.6px 3.4px
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 14px 30px -16px rgba(7, 17, 8, 0.45);
    animation: vini-spin 7s linear infinite;
  }
  .vini-node:hover .vini-disc {
    animation-duration: 2.2s;
  }
  /* riflesso obliquo statico (non gira) */
  .vini-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.18) 0 16%, transparent 36%);
  }
  /* etichetta centrale rossa con icona — non ruota */
  .vini-label {
    position: relative;
    z-index: 1;
    width: 44%;
    height: 44%;
    border-radius: 50%;
    background: var(--color-butik-red);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9);
  }
  .vini-num {
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    z-index: 2;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    background: var(--color-butik-red);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 0 0 4px #fff;
  }
  .vini-title {
    text-transform: none !important;
    letter-spacing: -0.005em !important;
    color: var(--color-butik-dark) !important;
  }

  @keyframes vini-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Mobile: colonna con rail tratteggiato a sinistra ─────────────────── */
  @media (max-width: 767px) {
    .vini {
      position: relative;
    }
    .vini::before {
      content: '';
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: 3.25rem;
      border-left: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 45%, transparent);
    }
    .vini-step {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      padding-bottom: 2.5rem;
    }
    .vini-step:last-child { padding-bottom: 0; }
    .vini-node {
      width: 5.5rem;
      height: 5.5rem;
      z-index: 1;
    }
    .vini-content { padding-top: 0.75rem; }
  }

  /* ── Desktop: fila orizzontale, connettore tratteggiato singolo ───────── */
  @media (min-width: 768px) {
    .vini {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: clamp(0.5rem, 1.5vw, 1.5rem);
    }
    .vini-step {
      position: relative;
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .vini-content {
      margin-top: 1.25rem;
      width: min(14rem, 95%);
    }
    .vini-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 3.25rem;
      left: calc(50% + 3.5rem);
      right: calc(-50% + 3.5rem);
      border-top: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 55%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vini-disc { animation: none; }
  }
</style>
