---
// ── Studio musica 1 — Connettori = onde sonore ────────────────────────────
// I nodi restano i cerchi-con-arco del metodo; i connettori tra una tappa e
// l'altra diventano una waveform animata che scorre (riprende Waveform.astro).
// Il connettore è UN solo elemento centrato tra i due nodi → niente scollamento
// linea/punta come nella versione attuale (frecce disallineate).
import { tappe } from '../../../../data/metodo';
import MetodoIcon from '../../MetodoIcon.astro';

// Path onda sinusoidale (quadratiche), periodo 64px → loop di -64px perfetto.
const W = 640;
const SEG = 32;
const AMP = 9;
const MID = 16;
let d = `M0 ${MID}`;
let up = true;
for (let x = 0; x < W; x += SEG) {
  d += ` Q ${x + SEG / 2} ${up ? MID - AMP : MID + AMP} ${x + SEG} ${MID}`;
  up = !up;
}

// Versione verticale (per il rail mobile: onda continua che scende lungo la
// colonna). Periodo più corto (SEGV) → onde più dense. H pari a un numero intero
// di periodi e H/2 (lo shift del loop) anch'esso intero → scorrimento seamless.
const SEGV = 20;
const H = 1600;
let dv = `M${MID} 0`;
let upv = true;
for (let y = 0; y < H; y += SEGV) {
  dv += ` Q ${upv ? MID - AMP : MID + AMP} ${y + SEGV / 2} ${MID} ${y + SEGV}`;
  upv = !upv;
}
---

<section class="bg-white py-12 md:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
        Come lavoriamo
      </p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-butik-dark">
        Il nostro metodo
      </h2>
    </div>

    <ol class="onde">
      {/* rail-onda continuo che scende: visibile solo su mobile */}
      <span class="onde-rail" aria-hidden="true">
        <svg viewBox={`0 0 ${MID * 2} ${H}`} preserveAspectRatio="none">
          <path d={dv} />
        </svg>
      </span>
      {
        tappe.map((tappa, i) => (
          <li class="onde-step">
            <div class="onde-node">
              <svg class="onde-arc" viewBox="0 0 100 100" aria-hidden="true">
                <circle
                  cx="50"
                  cy="50"
                  r="46"
                  fill="none"
                  stroke="var(--color-butik-red)"
                  stroke-width="5"
                  stroke-linecap="round"
                  stroke-dasharray="230 60"
                  transform="rotate(135 50 50)"
                />
              </svg>
              <span class="onde-num font-display">{String(i + 1).padStart(2, '0')}</span>
              <MetodoIcon name={tappa.icon} size={30} class="onde-icon" />
            </div>
            {i < tappe.length - 1 && (
              <span class="onde-link" aria-hidden="true">
                <svg viewBox="0 0 640 32" preserveAspectRatio="none">
                  <path d={d} />
                </svg>
              </span>
            )}
            <div class="onde-content">
              <h3 class="onde-title font-heading text-lg font-bold text-butik-dark">
                {tappa.title}
              </h3>
              <p class="font-sans text-sm text-butik-dark/70 leading-relaxed mt-1">
                {tappa.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .onde {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .onde-node {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 9999px;
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    flex-shrink: 0;
    color: var(--color-butik-red);
    box-shadow: 0 14px 30px -16px rgba(7, 17, 8, 0.35);
  }
  .onde-arc {
    position: absolute;
    inset: -3px;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    overflow: visible;
  }
  .onde-num {
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    background: var(--color-butik-red);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 0 0 4px #fff;
  }
  .onde-title {
    text-transform: none !important;
    letter-spacing: -0.005em !important;
    color: var(--color-butik-dark) !important;
  }

  /* onda di collegamento (un solo elemento, sempre allineato al centro nodo) */
  .onde-link {
    position: absolute;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-butik-red) 65%, transparent);
  }
  .onde-link svg {
    display: block;
    width: 200%;
    height: 100%;
    /* scorre verso destra (verso la tappa successiva) */
    animation: onde-scroll 3.5s linear infinite;
  }
  .onde-link path,
  .onde-rail path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  /* rail verticale: nascosto di default, mostrato su mobile */
  .onde-rail { display: none; }

  @keyframes onde-scroll {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @keyframes onde-scroll-v {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }

  /* ── Mobile: colonna verticale con onda continua che scende ───────────── */
  @media (max-width: 767px) {
    .onde { position: relative; }
    /* onda verticale dietro la colonna, centrata sull'asse dei nodi;
       i nodi (bianchi, z-index 1) la coprono → l'onda "esce" solo tra un
       cerchio e l'altro, collegandoli mentre scorre verso il basso */
    .onde-rail {
      display: block;
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: 2.75rem;
      width: 2rem;
      transform: translateX(-50%);
      overflow: hidden;
      color: color-mix(in srgb, var(--color-butik-red) 65%, transparent);
      z-index: 0;
    }
    .onde-rail svg {
      display: block;
      width: 100%;
      height: 200%;
      animation: onde-scroll-v 7s linear infinite;
    }
    .onde-step {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      padding-bottom: 2.5rem;
      z-index: 1;
    }
    .onde-step:last-child { padding-bottom: 0; }
    .onde-node {
      width: 5.5rem;
      height: 5.5rem;
      z-index: 1;
    }
    .onde-content { padding-top: 0.75rem; }
    .onde-link { display: none; }
  }

  /* ── Desktop: fila orizzontale, onda tra i nodi ───────────────────────── */
  @media (min-width: 768px) {
    .onde {
      /* gap condiviso tra flex e calcolo connettore + ancore nodo */
      --onde-gap: clamp(0.5rem, 1.5vw, 1.5rem);
      --onde-r: 3.25rem;
      --onde-pad: 0.4rem;
      --onde-end: calc(var(--onde-r) + var(--onde-pad) - var(--onde-gap) - 50%);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--onde-gap);
    }
    .onde-step {
      position: relative;
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .onde-content {
      margin-top: 1.25rem;
      width: min(14rem, 95%);
    }
    /* l'onda parte dal bordo destro del nodo e arriva a quello sinistro del
       successivo: ancore relative allo step (non al nodo) → connette i cerchi */
    .onde-link {
      top: 3.25rem;
      left: calc(50% + var(--onde-r) + var(--onde-pad));
      right: var(--onde-end);
      height: 2rem;
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .onde-link svg,
    .onde-rail svg { animation: none; }
  }
</style>
