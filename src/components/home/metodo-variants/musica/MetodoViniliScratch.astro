---
// ── Studio musica 5 — Nodi = vinili interattivi (scratch) ─────────────────
// Variante di MetodoVinili con i nuovi dischi: ogni nodo è un vinile con
// riflesso conico che gira col disco (segnale di moto, dato che i solchi
// concentrici sono simmetrici). All'hover NON accelera: si "scratcha", il disco
// segue il mouse come sotto la mano del dj e al rilascio rallenta per inerzia
// (logica condivisa in #lib/motion/vinylScratch). Etichetta-icona e badge
// numerato restano fermi sopra. Connettore: trattini singoli, allineati.
import { tappe } from '../../../../data/metodo';
import MetodoIcon from '../../MetodoIcon.astro';
---

<section class="bg-white py-12 md:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
        Come lavoriamo
      </p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-butik-dark">
        Il nostro metodo
      </h2>
    </div>

    <ol class="vinx">
      {
        tappe.map((tappa, i) => (
          <li class="vinx-step">
            <div class="vinx-node">
              <span class="vinx-disc" aria-hidden="true">
                <span class="vinx-glint"></span>
              </span>
              <span class="vinx-label">
                <MetodoIcon name={tappa.icon} size={26} class="vinx-icon" />
              </span>
              <span class="vinx-num font-display">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="vinx-content">
              <h3 class="vinx-title font-heading text-lg font-bold text-butik-dark">
                {tappa.title}
              </h3>
              <p class="font-sans text-sm text-butik-dark/70 leading-relaxed mt-1">
                {tappa.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .vinx {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vinx-node {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    touch-action: none;
    --vinx-speed: 7s;
  }
  .vinx-node:active { cursor: grabbing; }
  /* disco: solchi concentrici + ombra */
  .vinx-disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle at center,
      #0c0c0c 0 1.6px,
      #1f1f1f 1.6px 3.4px
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 14px 30px -16px rgba(7, 17, 8, 0.45);
    /* fallback no-JS: spin a velocità fissa. Con JS la rotazione (e l'inerzia
       dello scratch) è guidata da requestAnimationFrame, che disattiva questa. */
    animation: vinx-spin var(--vinx-speed, 7s) linear infinite;
  }
  /* riflesso luminoso che gira col disco: segnale di moto + lucidità del
     vinile. Due lobi opposti, come la luce su un disco vero. */
  .vinx-glint {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
    background: conic-gradient(
      from -55deg,
      rgba(255, 255, 255, 0.6) 0deg,
      rgba(255, 255, 255, 0.05) 26deg,
      transparent 60deg,
      transparent 150deg,
      rgba(255, 255, 255, 0.38) 180deg,
      rgba(255, 255, 255, 0.03) 206deg,
      transparent 240deg,
      transparent 360deg
    );
  }
  /* etichetta centrale rossa con icona — non ruota */
  .vinx-label {
    position: relative;
    z-index: 1;
    width: 44%;
    height: 44%;
    border-radius: 50%;
    background: var(--color-butik-red);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9);
    pointer-events: none;
  }
  .vinx-num {
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    z-index: 2;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    background: var(--color-butik-red);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 0 0 4px #fff;
    pointer-events: none;
  }
  .vinx-title {
    text-transform: none !important;
    letter-spacing: -0.005em !important;
    color: var(--color-butik-dark) !important;
  }

  @keyframes vinx-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Mobile: colonna con rail tratteggiato a sinistra ─────────────────── */
  @media (max-width: 767px) {
    .vinx {
      position: relative;
    }
    .vinx::before {
      content: '';
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: 3.25rem;
      border-left: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 45%, transparent);
    }
    .vinx-step {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      padding-bottom: 2.5rem;
    }
    .vinx-step:last-child { padding-bottom: 0; }
    .vinx-node {
      width: 5.5rem;
      height: 5.5rem;
      z-index: 1;
    }
    .vinx-content { padding-top: 0.75rem; }
  }

  /* ── Desktop: fila orizzontale, connettore tratteggiato singolo ───────── */
  @media (min-width: 768px) {
    .vinx {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: clamp(0.5rem, 1.5vw, 1.5rem);
    }
    .vinx-step {
      position: relative;
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .vinx-content {
      margin-top: 1.25rem;
      width: min(14rem, 95%);
    }
    .vinx-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 3.25rem;
      left: calc(50% + 3.5rem);
      right: calc(-50% + 3.5rem);
      border-top: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 55%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinx-disc { animation: none; }
  }
</style>

<script>
  import { initVinylScratch } from '#lib/motion/vinylScratch';

  initVinylScratch({
    nodeSelector: '.vinx-node',
    discSelector: '.vinx-disc',
    speedVar: '--vinx-speed',
    defaultSpeed: 7,
  });
</script>
