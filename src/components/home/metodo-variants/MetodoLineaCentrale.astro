---
// ── Variante 2 — Linea centrale + card alternate (rif. 2 / 6) ─────────────
// Linea orizzontale rossa tratteggiata con nodi-cerchio equidistanti; card
// titolo+testo alternate sopra/sotto, con connettore verticale tratteggiato.
// Su mobile: linea verticale a sinistra + card incolonnate.
import { tappe } from '../../../data/metodo';
import MetodoIcon from '../MetodoIcon.astro';
---

<section class="bg-butik-light py-12 md:py-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-20">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
        Come lavoriamo
      </p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-butik-dark">
        Il nostro metodo
      </h2>
    </div>

    <ol class="linea">
      {
        tappe.map((tappa, i) => (
          <li class="linea-step" data-pos={i % 2 === 0 ? 'top' : 'bottom'}>
            <div class="linea-node">
              <MetodoIcon name={tappa.icon} size={24} />
            </div>
            <span class="linea-num font-display">{String(i + 1).padStart(2, '0')}</span>
            <div class="linea-card">
              <h3 class="linea-title font-heading text-lg font-bold text-butik-dark">
                {tappa.title}
              </h3>
              <p class="font-sans text-sm text-butik-dark/70 leading-relaxed mt-1">
                {tappa.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .linea {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .linea-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: var(--color-butik-red);
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 0 0 5px var(--color-butik-light);
    z-index: 2;
  }
  .linea-num {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-butik-red);
  }
  .linea-card {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-butik-dark) 8%, transparent);
    border-radius: 0.9rem;
    padding: 1rem 1.1rem;
    box-shadow: 0 12px 30px -18px rgba(7, 17, 8, 0.4);
  }
  .linea-title {
    text-transform: none !important;
    letter-spacing: -0.005em !important;
    color: var(--color-butik-dark) !important;
  }

  /* ── Mobile: linea verticale a sinistra, card incolonnate ─────────────── */
  @media (max-width: 767px) {
    .linea {
      position: relative;
    }
    .linea::before {
      content: '';
      position: absolute;
      top: 1.75rem;
      bottom: 1.75rem;
      left: 1.75rem;
      border-left: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 45%, transparent);
    }
    .linea-step {
      position: relative;
      padding-left: 5rem;
      padding-bottom: 2rem;
    }
    .linea-step:last-child {
      padding-bottom: 0;
    }
    .linea-node {
      position: absolute;
      left: 0;
      top: 0;
    }
    .linea-num {
      position: absolute;
      left: 1rem;
      top: 3.75rem;
      font-size: 0.8rem;
    }
  }

  /* ── Desktop: linea orizzontale, card sopra/sotto alternate ───────────── */
  @media (min-width: 768px) {
    .linea {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: clamp(0.5rem, 1.5vw, 1.5rem);
      position: relative;
      padding: 14rem 0;
    }
    .linea::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      border-top: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 50%, transparent);
      z-index: 0;
    }
    .linea-step {
      position: relative;
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .linea-num {
      margin-top: 0.4rem;
    }
    .linea-card {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: min(13rem, 92%);
    }
    .linea-card::after {
      content: '';
      position: absolute;
      left: 50%;
      width: 0;
      height: 2rem;
      border-left: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 50%, transparent);
    }
    .linea-step[data-pos='top'] .linea-card {
      bottom: calc(50% + 3.25rem);
    }
    .linea-step[data-pos='top'] .linea-card::after {
      top: 100%;
    }
    .linea-step[data-pos='bottom'] .linea-card {
      top: calc(50% + 3.25rem);
    }
    .linea-step[data-pos='bottom'] .linea-card::after {
      bottom: 100%;
    }
  }
</style>
