---
// ── Variante 3 — Cerchi grandi con archi (rif. 1) ─────────────────────────
// È la variante SCELTA, oggi in home (src/components/home/Metodo.astro).
// Qui resta solo per il confronto in /lab/metodo.
import { tappe } from '../../../data/metodo';
import MetodoIcon from '../MetodoIcon.astro';
---

<section class="bg-white py-12 md:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
        Come lavoriamo
      </p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-butik-dark">
        Il nostro metodo
      </h2>
    </div>

    <ol class="archi">
      {
        tappe.map((tappa, i) => (
          <li class="archi-step">
            <div class="archi-node">
              <svg class="archi-arc" viewBox="0 0 100 100" aria-hidden="true">
                <circle
                  cx="50"
                  cy="50"
                  r="46"
                  fill="none"
                  stroke="var(--color-butik-red)"
                  stroke-width="5"
                  stroke-linecap="round"
                  stroke-dasharray="230 60"
                  transform="rotate(135 50 50)"
                />
              </svg>
              <span class="archi-num font-display">{String(i + 1).padStart(2, '0')}</span>
              <MetodoIcon name={tappa.icon} size={30} class="archi-icon" />
            </div>
            <div class="archi-content">
              <h3 class="archi-title font-heading text-lg font-bold text-butik-dark">
                {tappa.title}
              </h3>
              <p class="font-sans text-sm text-butik-dark/70 leading-relaxed mt-1">
                {tappa.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .archi {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archi-node {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 9999px;
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    flex-shrink: 0;
    color: var(--color-butik-red);
    box-shadow: 0 14px 30px -16px rgba(7, 17, 8, 0.35);
  }
  .archi-arc {
    position: absolute;
    inset: -3px;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    overflow: visible;
  }
  .archi-num {
    position: absolute;
    top: -0.6rem;
    left: -0.6rem;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    background: var(--color-butik-red);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 0 0 4px #fff;
  }
  .archi-title {
    text-transform: none !important;
    letter-spacing: -0.005em !important;
    color: var(--color-butik-dark) !important;
  }

  @media (max-width: 767px) {
    .archi {
      position: relative;
    }
    .archi::before {
      content: '';
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: 3.25rem;
      border-left: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 45%, transparent);
    }
    .archi-step {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      padding-bottom: 2.5rem;
    }
    .archi-step:last-child {
      padding-bottom: 0;
    }
    .archi-node {
      width: 5.5rem;
      height: 5.5rem;
      z-index: 1;
    }
    .archi-content {
      padding-top: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .archi {
      /* gap condiviso tra flex e calcolo connettori: una sola fonte di verità */
      --archi-gap: clamp(0.5rem, 1.5vw, 1.5rem);
      --archi-r: 3.25rem;
      --archi-pad: 0.4rem;
      /* va sottratto anche il gap: distanza tra centri nodo = step + gap */
      --archi-end: calc(var(--archi-r) + var(--archi-pad) - var(--archi-gap) - 50%);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--archi-gap);
    }
    .archi-step {
      position: relative;
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .archi-content {
      margin-top: 1.25rem;
      width: min(14rem, 95%);
    }
    .archi-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 3.25rem;
      left: calc(50% + var(--archi-r) + var(--archi-pad));
      right: var(--archi-end);
      border-top: 2px dashed
        color-mix(in srgb, var(--color-butik-red) 55%, transparent);
    }
    /* punta: stessa ancora `right` della linea → sempre allineata */
    .archi-step:not(:last-child)::before {
      content: '';
      position: absolute;
      top: calc(3.25rem - 4px);
      right: var(--archi-end);
      width: 8px;
      height: 8px;
      border-top: 2px solid
        color-mix(in srgb, var(--color-butik-red) 55%, transparent);
      border-right: 2px solid
        color-mix(in srgb, var(--color-butik-red) 55%, transparent);
      transform: rotate(45deg);
      z-index: 1;
    }
  }
</style>
