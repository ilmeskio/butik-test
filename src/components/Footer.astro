const year = new Date().getFullYear();
---

<footer class="bg-butik-light text-butik-dark py-6 md:py-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="border border-butik-dark/15 px-5 md:px-8 py-3 md:py-4">

      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto_auto] gap-x-8 gap-y-6 items-center">
        <!-- Col 1: Logo (centrato verticalmente nel box) -->
        <a href="/" class="flex items-center flex-shrink-0">
          <Image src={logo} alt="Butik" width={420} height={276} class="h-56 md:h-72 w-auto" />
        </a>

        <!-- Col 2: Info aziendale -->
        <div class="flex flex-col gap-3">
          <address class="not-italic font-sans text-sm text-butik-dark/70 leading-relaxed">
            <strong class="font-bold text-butik-dark">Butik s.r.l. Impresa Sociale</strong><br />
            Via Plinio 14, 20129 Milano — Italy<br />
            P. IVA 10429130965
          </address>

          <div>
            <p class="font-display text-xs font-bold tracking-widest uppercase mb-1">
              PEC &amp; Email
            </p>
            <p class="font-sans text-sm">
              <a href="mailto:butik@legalmail.it" class="text-butik-dark underline hover:text-butik-red">butik@legalmail.it</a><br />
              <a href="mailto:info@wearebutik.com" class="text-butik-dark underline hover:text-butik-red">info@wearebutik.com</a>
            </p>
          </div>

          <ul class="flex items-center gap-4">
            {socials.map(s => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="text-butik-dark hover:text-butik-red transition-colors inline-block"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={s.path} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Col 3: link 1 (la colonna stessa è a destra grazie al grid, testo sx) -->
        <nav aria-label="Sezioni sito">
          <ul class="flex flex-col">
            {linksColumn1.map(link => (
              <li>
                <a
                  href={link.href}
                  class="block py-1 font-sans text-sm text-butik-dark hover:text-butik-red transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Col 4: link 2 (la colonna stessa è a destra grazie al grid, testo sx) -->
        <nav aria-label="Sezioni servizio">
          <ul class="flex flex-col">
            {linksColumn2.map(link => (
              <li>
                <a
                  href={link.href}
                  class="block py-1 font-sans text-sm text-butik-dark hover:text-butik-red transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Bottom bar -->
      <div class="border-t border-butik-dark/10 mt-5 pt-4 flex flex-col md:flex-row md:justify-between gap-3 text-xs text-butik-dark/50">
        <p>&copy; {year} Butik. Tutti i diritti riservati.</p>
        <p class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="/privacy" class="hover:text-butik-red transition-colors">Privacy policy</a>
          <a href="/termini" class="hover:text-butik-red transition-colors">Termini di utilizzo</a>
          <a href="/cookie-settings" class="hover:text-butik-red transition-colors">Cookie settings</a>
        </p>
      </div>
    </div>
  </div>
</footer>
