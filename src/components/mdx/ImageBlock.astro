---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  height?: string;
}

const { src, alt = '', caption, height = 'h-80 md:h-[500px]' } = Astro.props;
---

<figure class={`my-12 not-prose w-full ${height} overflow-hidden rounded-sm`}>
  <img
    src={src}
    alt={alt}
    class="w-full h-full object-cover"
  />
  {caption && (
    <figcaption class="mt-3 text-center text-sm text-butik-body font-sans italic">
      {caption}
    </figcaption>
  )}
</figure>
