---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
---

<div class="my-12 grid grid-cols-1 md:grid-cols-2 gap-8 items-center not-prose">
  <!-- Text (left) -->
  <div class="prose prose-lg max-w-none">
    <slot />
  </div>

  <!-- Image (right) -->
  <figure class="m-0">
    <img
      src={src}
      alt={alt}
      class="w-full h-auto object-cover rounded-sm"
    />
    {caption && (
      <figcaption class="mt-2 text-center text-sm text-butik-body font-sans italic">
        {caption}
      </figcaption>
    )}
  </figure>
</div>
