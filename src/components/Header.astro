---
import { Image } from 'astro:assets';
import logo from '../assets/logos/bollo-rosso.svg';

const navLinks = [
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/contatti', label: 'Contatti' },
  { href: '/progetti', label: 'Portfolio' },
  { href: '/blog', label: 'Blog' },
  // TEMP — link interno alle varianti in valutazione. Rimuovere prima del lancio.
  { href: '/lab', label: 'Lab' },
];

const ctaHref = '/contatti';
const ctaLabel = 'Lavoriamo insieme';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  data-overlay={isHome ? 'true' : 'false'}
  class:list={[
    'site-header sticky top-0 z-50 transition-colors duration-300',
    isHome
      ? 'bg-transparent'
      : 'bg-butik-light border-b border-butik-dark/10',
  ]}
>
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">

    <!-- Left: Logo + Primary Nav -->
    <div class="flex items-center gap-10">
      <a href="/" class="flex-shrink-0 relative z-10">
        <Image src={logo} alt="Butik" width={45} height={45} loading="eager" class="site-logo h-[2.8125rem] w-auto" />
      </a>
      <nav class="hidden md:flex items-center gap-8" aria-label="Navigazione principale">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`nav-link font-display text-xs font-bold tracking-widest uppercase transition-colors ${
              isActive(link.href)
                ? 'text-butik-red'
                : 'text-butik-dark hover:text-butik-red'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Right: CTA -->
    <a
      href={ctaHref}
      class="header-cta hidden md:inline-block bg-butik-dark text-white px-5 py-3 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-red transition-colors"
    >
      {ctaLabel}
    </a>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="mobile-toggle md:hidden p-3 transition-colors"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-butik-dark/10 bg-butik-light">
    <nav class="flex flex-col px-6 py-4 gap-1" aria-label="Navigazione principale mobile">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-display text-xs font-bold tracking-widest uppercase py-3 ${
            isActive(link.href) ? 'text-butik-red' : 'text-butik-dark'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href={ctaHref}
        class="block w-full text-center bg-butik-dark text-white px-5 py-4 mt-3 font-display text-xs font-bold tracking-widest uppercase"
      >
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  /* In modalità overlay (homepage) sopra l'hero — ora vale a tutti i breakpoint
     perché l'hero è uniformemente scuro anche su desktop. */
  .site-header[data-overlay="true"]:not([data-scrolled="true"]) .mobile-toggle {
    color: #ffffff;
    filter: drop-shadow(0 1px 4px rgba(7, 17, 8, 0.45));
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]) .site-logo {
    filter: drop-shadow(0 1px 4px rgba(7, 17, 8, 0.45));
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]) .nav-link {
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(7, 17, 8, 0.45);
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]) .nav-link:hover {
    color: var(--color-butik-red);
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]) .header-cta {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(4px);
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]) .header-cta:hover {
    background-color: var(--color-butik-red);
    border-color: var(--color-butik-red);
  }

  /* Transizione smooth quando il header passa da overlay a solido. */
  .site-logo,
  .mobile-toggle,
  .nav-link,
  .header-cta {
    transition: filter 300ms ease, color 300ms ease, background-color 300ms ease,
      border-color 300ms ease, text-shadow 300ms ease;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });

  // Toggle stato "scrolled" del header in base alla posizione di scroll.
  // Sopra l'hero (scroll < 80px) → overlay trasparente con elementi chiari.
  // Appena si scrolla → header solido bg-butik-light con elementi scuri.
  const header = document.getElementById('site-header');
  if (header && header.dataset.overlay === 'true') {
    let ticking = false;
    const updateHeader = () => {
      const scrolled = window.scrollY > 60;
      header.dataset.scrolled = scrolled ? 'true' : 'false';
      if (scrolled) {
        header.classList.add('bg-butik-light', 'border-b', 'border-butik-dark/10');
        header.classList.remove('bg-transparent');
      } else {
        header.classList.remove('bg-butik-light', 'border-b', 'border-butik-dark/10');
        header.classList.add('bg-transparent');
      }
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateHeader);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    updateHeader();
  }
</script>
