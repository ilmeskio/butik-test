---
import BaseLayout from '#layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Eyebrow from '@butik/ui/Eyebrow';

// Copy + lista partner content-driven (ADR-0004): collezione `pagine` (entry
// `partners`), con i loghi come media risolti a build-time da `image()`.
const entry = await getEntry('pagine', 'partners');
if (!entry || entry.data.type !== 'partners') {
  throw new Error('Contenuto pagina "partners" mancante o non valido (collezione pagine).');
}
const c = entry.data;
const partners = c.partners;
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <!-- Page header -->
  <div class="pt-20 pb-12 text-center">
    <Eyebrow>{c.eyebrow}</Eyebrow>
    <h1 class="font-heading text-5xl font-bold text-butik-dark">{c.title}</h1>
  </div>

  <!-- Lista logo · partner -->
  <section class="max-w-3xl mx-auto px-6 pb-24">
    <ul class="divide-y divide-butik-dark/10 border-y border-butik-dark/10">
      {partners.map((partner) => (
        <li class="flex items-center gap-6 py-5">
          <span class="shrink-0 flex items-center justify-center bg-white rounded-xl ring-1 ring-butik-dark/5 w-40 h-16 px-4">
            {partner.logo && (
              <Image
                src={partner.logo}
                alt={partner.name}
                height={36}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
                class="max-h-9 w-auto"
              />
            )}
          </span>
          <span class="font-sans text-base md:text-lg text-butik-dark">
            {partner.name}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
