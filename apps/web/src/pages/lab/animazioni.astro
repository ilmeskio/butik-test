---
// LAB — studio motion & grafica a tema musica. Tratti riutilizzabili sul sito.
import BaseLayout from '#layouts/BaseLayout.astro';
import Equalizer from '#components/motion/Equalizer.astro';
import Waveform from '#components/motion/Waveform.astro';
import Marquee from '#components/motion/Marquee.astro';
import BeatPulse from '#components/motion/BeatPulse.astro';
import CountUp from '#components/motion/CountUp.astro';
import Vinyl from '#components/motion/Vinyl.astro';
import TapeReels from '#components/motion/TapeReels.astro';
import FlowDivider from '#components/motion/FlowDivider.astro';
import Underline from '#components/motion/Underline.astro';
import Mark from '#components/motion/Mark.astro';

const marqueeWords = ['Musica', 'Territorio', 'Comunità', 'Nuove generazioni', 'Cultura', 'Turismo'];
---

<BaseLayout title="Lab · Animazioni — Butik" description="Studio interno: motion e grafica a tema musica, tratti riutilizzabili.">
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-8">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-3">Lab · motion & grafica</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-4">Tratti animati a tema musica</h1>
    <p class="font-sans text-base md:text-lg text-butik-body max-w-2xl leading-relaxed">
      Quattro motivi (più un bonus) pensati come componenti riusabili, da innestare nel sito dove serve
      carattere. Tutti reduced-motion safe e si riagganciano alle navigazioni client-side.
    </p>
  </section>

  <!-- 1. EQUALIZER ──────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">01 · Equalizer</p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Barre da visualizzatore</h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-6">La firma musicale. Accanto a titoli/eyebrow, dentro una CTA “live”, o come accento ricorrente. Movimento organico (barre fuori sincrono).</p>

    <div class="flex flex-wrap items-end gap-8">
      <div class="flex flex-col items-center gap-2"><Equalizer size="sm" tone="onLight" /><span class="text-xs text-butik-dark/50">sm · rosso</span></div>
      <div class="flex flex-col items-center gap-2"><Equalizer size="md" tone="onLight" bars={7} /><span class="text-xs text-butik-dark/50">md · 7 barre</span></div>
      <div class="flex flex-col items-center gap-2"><Equalizer size="lg" tone="onLight" /><span class="text-xs text-butik-dark/50">lg</span></div>
      <div class="flex flex-col items-center gap-2 bg-butik-dark rounded-lg px-5 py-4"><Equalizer size="lg" tone="onDark" bars={8} /><span class="text-xs text-white/50">lg · verde su scuro</span></div>
    </div>
    <p class="mt-6 font-sans text-base text-butik-dark inline-flex items-center gap-2">
      In linea con un titolo <Equalizer size="md" tone="onLight" /> come questo.
    </p>
  </section>

  <!-- 2. WAVEFORM ───────────────────────────────────────────────────── -->
  <section class="py-10 border-t border-butik-dark/10">
    <div class="max-w-5xl mx-auto px-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">02 · Waveform</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Onda sonora che scorre</h2>
      <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-6">Divisore di sezione, sotto un titolo, o accento di banner. Loop continuo e perfettamente ciclico.</p>
    </div>
    <div class="max-w-5xl mx-auto px-6"><Waveform tone="onLight" height={56} speed={7} /></div>
    <div class="bg-butik-dark py-6 mt-4"><div class="max-w-5xl mx-auto px-6"><Waveform tone="onDark" height={48} speed={5} /></div></div>
  </section>

  <!-- 3. MARQUEE ────────────────────────────────────────────────────── -->
  <section class="py-10 border-t border-butik-dark/10">
    <div class="max-w-5xl mx-auto px-6 mb-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">03 · Marquee cinetico</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Testo che scorre, da poster</h2>
      <p class="font-sans text-sm text-butik-dark/60 max-w-2xl">Fascia di transizione tra sezioni o hook ricorrente. Si ferma all'hover. Due righe in direzioni opposte per ritmo.</p>
    </div>
    <Marquee items={marqueeWords} tone="onDark" speed={24} />
    <div class="h-1"></div>
    <Marquee items={marqueeWords} tone="onLight" reverse={true} speed={28} />
  </section>

  <!-- 4. BEAT PULSE ─────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">04 · Beat pulse</p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Pulsazione da altoparlante</h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-8">Segnale “in corso/live”: dietro un'icona, su una CTA, accanto a una data di evento.</p>

    <div class="flex flex-wrap items-center gap-12">
      <div class="flex items-center gap-4"><BeatPulse tone="red" size={14} /><span class="font-sans text-sm text-butik-dark/60">red</span></div>
      <div class="flex items-center gap-4"><BeatPulse tone="dark" size={14} /><span class="font-sans text-sm text-butik-dark/60">dark</span></div>
      <div class="flex items-center gap-4 bg-butik-dark rounded-lg px-6 py-4"><BeatPulse tone="green" size={14} /><span class="font-sans text-sm text-white/60">green su scuro</span></div>
      <span class="inline-flex items-center gap-3 bg-butik-red text-white px-5 py-3 font-display text-xs font-bold tracking-widest uppercase">
        <BeatPulse tone="dark" size={10} /> Evento dal vivo
      </span>
    </div>
  </section>

  <!-- 5. COUNTUP (bonus) ────────────────────────────────────────────── -->
  <section class="bg-butik-dark py-14 mt-4">
    <div class="max-w-5xl mx-auto px-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-green mb-1">05 · Count-up (bonus)</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-2">Numeri che salgono</h2>
      <p class="font-sans text-sm text-white/60 max-w-2xl mb-8">Per i numeri d'impatto: partono da zero quando entrano in vista. Da abbinare alla sezione “numeri”.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <CountUp value={30} suffix="+" label="progetti realizzati" />
        <CountUp value={70} suffix="K+" label="persone raggiunte" />
        <CountUp value={1000} suffix="+" label="giovani formati" />
        <CountUp value={9} label="bandi vinti" />
      </div>
    </div>
  </section>

  <!-- ════════ SET 2 ════════ -->
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-4">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2">Set 2</p>
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-butik-dark">Altri tratti & segni grafici</h2>
  </section>

  <!-- 06. VINYL ─────────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">06 · Vinyl</p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Disco che gira</h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-8">Accento-firma alternativo all'equalizer. Riflesso conico che gira col disco (i solchi concentrici da soli non mostrerebbero la rotazione); all'hover si scratcha — il disco segue il mouse come sotto la mano del dj e al rilascio riprende il giro. Accanto a un titolo, come loader, decoro d'angolo.</p>
    <div class="flex flex-wrap items-center gap-10">
      <Vinyl size={48} label="red" />
      <Vinyl size={72} label="dark" />
      <Vinyl size={56} label="green" speed={4} />
      <span class="inline-flex items-center gap-3 font-heading text-2xl font-bold text-butik-dark"><Vinyl size={40} label="red" /> Le nostre uscite</span>
    </div>
  </section>

  <!-- 07. TAPE REELS ────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">07 · Tape reels</p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Bobine che girano</h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-8">Accento-firma nostalgico. Bene in un footer-hook o accanto a un eyebrow.</p>
    <div class="flex flex-wrap items-center gap-10">
      <TapeReels size={44} tone="onLight" />
      <span class="inline-flex items-center gap-4 bg-butik-dark rounded-lg px-6 py-4"><TapeReels size={36} tone="onDark" speed={2.4} /><span class="font-display text-xs font-bold tracking-widest uppercase text-white/70">on air</span></span>
    </div>
  </section>

  <!-- 08. FLOW DIVIDER ──────────────────────────────────────────────── -->
  <section class="py-10 border-t border-butik-dark/10">
    <div class="max-w-5xl mx-auto px-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">08 · Flow divider</p>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Divisore che scorre</h2>
      <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-8">Alternativa “sottile” alla waveform per separare le sezioni: trattini in movimento + un bollo che viaggia.</p>
    </div>
    <div class="max-w-5xl mx-auto px-6"><FlowDivider tone="onLight" speed={3} /></div>
    <div class="bg-butik-dark py-7 mt-4"><div class="max-w-5xl mx-auto px-6"><FlowDivider tone="onDark" speed={2.4} /></div></div>
  </section>

  <!-- 09. UNDERLINE ─────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">09 · Underline</p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Sottolineatura che si disegna</h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-8">Accento per titoli/parole chiave: si traccia quando entra in vista (tratto irregolare, non una riga dritta).</p>
    <p class="font-heading text-3xl md:text-4xl font-bold text-butik-dark leading-snug max-w-2xl">
      Attiviamo territori attraverso la <Underline color="red">musica</Underline> e le <Underline color="purple">nuove generazioni</Underline>.
    </p>
  </section>

  <!-- 10. MARKS ─────────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-butik-dark/10">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-1">10 · Marks</p>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-butik-dark mb-2">Segni grafici da spruzzare</h2>
    <p class="font-sans text-sm text-butik-dark/60 max-w-2xl mb-8">Spark, croce, mirino, bollo, sparkle. Negli angoli, tra le parole, come elenco-marker. Con twinkle opzionale.</p>
    <div class="flex flex-wrap items-center gap-10">
      <div class="flex flex-col items-center gap-2"><Mark type="spark" color="red" size={32} /><span class="text-xs text-butik-dark/50">spark</span></div>
      <div class="flex flex-col items-center gap-2"><Mark type="sparkle" color="purple" size={32} /><span class="text-xs text-butik-dark/50">sparkle</span></div>
      <div class="flex flex-col items-center gap-2"><Mark type="plus" color="dark" size={32} /><span class="text-xs text-butik-dark/50">croce</span></div>
      <div class="flex flex-col items-center gap-2"><Mark type="reg" color="dark" size={32} /><span class="text-xs text-butik-dark/50">mirino</span></div>
      <div class="flex flex-col items-center gap-2"><Mark type="bollo" color="red" size={32} /><span class="text-xs text-butik-dark/50">bollo</span></div>
      <div class="flex flex-col items-center gap-2"><Mark type="spark" color="green" size={32} twinkle={true} /><span class="text-xs text-butik-dark/50">twinkle</span></div>
    </div>
    <p class="mt-8 font-heading text-2xl font-bold text-butik-dark inline-flex items-center gap-3">
      <Mark type="spark" color="red" size={22} twinkle={true} /> Cultura <Mark type="bollo" color="green" size={12} /> Territorio <Mark type="sparkle" color="purple" size={22} twinkle={true} />
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 text-center">
    <p class="font-sans text-sm text-butik-dark/60">
      Scegli quali innestare e dove — li cablo nelle pagine reali.
      <a href="/lab" class="text-butik-red underline ml-1">← torna al Lab</a>
    </p>
  </section>
</BaseLayout>
