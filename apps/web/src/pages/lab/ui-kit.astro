---
// Lab page: smoke-test the cross-package wiring — @butik/ui components consuming
// @butik/ui-tokens, resi a HTML statico dentro il sito (nessuna direttiva
// client Astro). Il catalogo completo, con tutte le varianti/stati, vive in
// Storybook (ADR-0008) — questa pagina prova solo che l'import cross-package
// funziona, non sostituisce la copertura.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '@butik/ui/Button';
import Eyebrow from '@butik/ui/Eyebrow';
import NumberBadge from '@butik/ui/NumberBadge';
---

<BaseLayout title="UI kit — lab">
  <main style="max-width: 48rem; margin: 0 auto; padding: var(--space-24) var(--space-6); display: flex; flex-direction: column; gap: var(--space-8);">
    <h1 style="font-family: var(--font-heading); color: var(--color-fg);">
      @butik/ui — smoke test
    </h1>
    <p style="font-family: var(--font-sans); color: var(--color-fg);">
      Prova di consumo cross-package con i token di <code>@butik/ui-tokens</code>.
      Catalogo completo (atoms/molecules/organisms, tutte le varianti): Storybook.
    </p>
    <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: center;">
      <Button href="/contatti" variant="primary">Primary</Button>
      <Button href="/servizi" variant="ghost">Ghost</Button>
    </div>
    <Eyebrow>Esempio eyebrow</Eyebrow>
    <div style="display: flex; gap: var(--space-4);">
      <NumberBadge number={1} />
      <NumberBadge number={12} />
    </div>
  </main>
</BaseLayout>
