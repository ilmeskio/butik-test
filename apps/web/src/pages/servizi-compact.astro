---
// PROTOTIPO — launcher compatto dei servizi per l'hero (mobile-friendly).
// Mostra lista vs strip su sfondo scuro (contesto hero), con anteprima a
// larghezza telefono per valutare la densità above-the-fold.
import BaseLayout from '#layouts/BaseLayout.astro';
import ServiceLauncher from '#components/serviziCards/ServiceLauncher.astro';
---

<BaseLayout title="Launcher servizi compatto — Butik" description="Prototipo interno: lancio compatto dei servizi nell'hero.">
  <section class="max-w-7xl mx-auto px-6 pt-24 pb-8">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-3">Prototipo interno</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-4">Servizi nell'hero — versione compatta</h1>
    <p class="font-sans text-base md:text-lg text-butik-body max-w-3xl leading-relaxed">
      Le card ricche restano su <a class="text-butik-red underline" href="/card-varianti">/card-varianti</a> (per la pagina
      /servizi). Qui invece il lancio dei 5 servizi per l'<strong>hero</strong>, dove conta la densità: tutti
      scansionabili sopra la piega, anche da telefono. A destra l'anteprima a larghezza ~390px.
    </p>
  </section>

  <!-- LISTA ─────────────────────────────────────────────────────────── -->
  <section class="bg-butik-dark py-12">
    <div class="max-w-7xl mx-auto px-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-green mb-6">
        1 · Lista compatta (contesto hero scuro)
      </p>
      <div class="grid lg:grid-cols-[1fr_390px] gap-10 items-start">
        <div>
          <ServiceLauncher mode="list" tone="onDark" />
        </div>
        <div class="phone">
          <p class="phone__label">~390px (telefono)</p>
          <div class="phone__screen bg-butik-dark">
            <ServiceLauncher mode="list" tone="onDark" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STRIP ─────────────────────────────────────────────────────────── -->
  <section class="bg-butik-dark py-12 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-green mb-6">
        2 · Strip orizzontale scorrevole (contesto hero scuro)
      </p>
      <div class="grid lg:grid-cols-[1fr_390px] gap-10 items-start">
        <div>
          <ServiceLauncher mode="strip" tone="onDark" />
          <p class="font-sans text-xs text-white/50 mt-3">↔ si scorre col dito / trackpad</p>
        </div>
        <div class="phone">
          <p class="phone__label">~390px (telefono)</p>
          <div class="phone__screen bg-butik-dark">
            <ServiceLauncher mode="strip" tone="onDark" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Su sfondo chiaro (contesto /servizi) ──────────────────────────── -->
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-6">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-6">
        Le stesse, su sfondo chiaro
      </p>
      <ServiceLauncher mode="list" tone="onLight" />
    </div>
  </section>
</BaseLayout>

<style>
  .phone__label {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.5rem;
  }
  .phone__screen {
    width: 390px;
    max-width: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1.25rem;
  }
</style>
