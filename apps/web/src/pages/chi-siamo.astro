---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Testimonials from '../components/home/Testimonials.astro';
import { Image } from 'astro:assets';

import heroImg from '../assets/hero-home.jpg';
import founder1 from '../assets/servizi/template-servizio/gallery-1.jpg';
import founder2 from '../assets/servizi/template-servizio/gallery-2.jpg';
import founder3 from '../assets/servizi/template-servizio/gallery-3.jpg';

// Copy editoriale content-driven via collezione `pagine` (ADR-0004): il testo è
// editabile da Sitepins, la presentazione resta qui. Alcuni paragrafi contengono
// <strong>/link inline e vengono resi con `set:html` per output identico.
const entry = await getEntry('pagine', 'chi-siamo');
if (!entry || entry.data.type !== 'chi-siamo') {
  throw new Error('Contenuto pagina "chi-siamo" mancante o non valido (collezione pagine).');
}
const c = entry.data;

// Le foto restano import build-time (asset), zippate per posizione con la copy.
// Email/LinkedIn placeholder ("#") arrivano dalla collezione finché non forniti
// i profili reali.
const founders = [
  { name: c.founder1Name, role: c.founder1Role, bio: c.founder1Bio, email: c.founder1Email, linkedin: c.founder1Linkedin, photo: founder1 },
  { name: c.founder2Name, role: c.founder2Role, bio: c.founder2Bio, email: c.founder2Email, linkedin: c.founder2Linkedin, photo: founder2 },
  { name: c.founder3Name, role: c.founder3Role, bio: c.founder3Bio, email: c.founder3Email, linkedin: c.founder3Linkedin, photo: founder3 },
];

// Obiettivi di Sviluppo Sostenibile (Agenda ONU 2030): i titoli sono copy
// editoriale (collezione), numero/colore/icona restano config di design qui —
// i colori sono quelli ufficiali SDG.
const sdg = [
  { num: 8, title: c.sdg8Title, color: '#A21942', icon: '🎯' },
  { num: 11, title: c.sdg11Title, color: '#FD9D24', icon: '🏙️' },
];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <HeroBanner
    title={c.heroTitle}
    subtitle={c.heroSubtitle}
    image={heroImg}
    imageAlt={c.heroImageAlt}
  />

  <!-- Chi siamo -->
  <section class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-6">{c.introEyebrow}</p>
    <div class="space-y-5 font-sans text-base md:text-lg text-butik-body leading-relaxed">
      <p set:html={c.introP1}></p>
      <p set:html={c.introP2}></p>
      <p set:html={c.introP3}></p>
      <p set:html={c.introP4}></p>
    </div>
  </section>

  <!-- La nostra missione + SDG -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">{c.missionEyebrow}</p>
        <p class="font-heading text-2xl md:text-3xl font-bold text-butik-dark leading-snug">
          {c.missionStatement}
        </p>
      </div>

      <div class="mt-12 md:mt-16">
        <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">
          {c.sdgEyebrow}
        </p>
        <p class="font-sans text-base text-butik-body leading-relaxed max-w-3xl">
          {c.sdgIntro}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-8">
          {sdg.map((o) => (
            <div class="flex items-center gap-5 border border-butik-dark/15 bg-butik-light/50 p-5 md:p-6">
              <span
                class="flex h-16 w-16 flex-shrink-0 flex-col items-center justify-center text-white"
                style={`background-color: ${o.color}`}
                aria-hidden="true"
              >
                <span class="text-xl leading-none">{o.icon}</span>
                <span class="font-display text-lg font-bold leading-none mt-1">{o.num}</span>
              </span>
              <div>
                <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red">
                  Obiettivo {o.num}
                </p>
                <p class="font-heading text-base md:text-lg font-bold text-butik-dark leading-snug mt-1">
                  {o.title}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Il nostro team -->
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <div class="max-w-3xl">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-6">{c.teamEyebrow}</p>
      <div class="space-y-5 font-sans text-base md:text-lg text-butik-body leading-relaxed">
        <p set:html={c.teamP1}></p>
        <p set:html={c.teamP2}></p>
        <p set:html={c.teamP3}></p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mt-12 md:mt-16">
      {founders.map((f) => (
        <article class="flex flex-col">
          <div class="overflow-hidden mb-5 aspect-[4/5] bg-butik-light">
            <Image
              src={f.photo}
              alt={`Ritratto di ${f.name}`}
              widths={[300, 500]}
              sizes="(max-width: 768px) 100vw, 33vw"
              quality={72}
              class="w-full h-full object-cover"
            />
          </div>
          <h2 class="font-heading text-xl font-bold text-butik-dark leading-tight">{f.name}</h2>
          <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mt-1">{f.role}</p>
          <p class="font-sans text-sm text-butik-body leading-relaxed mt-4 flex-1">{f.bio}</p>
          <div class="flex items-center gap-4 mt-5">
            <a
              href={f.linkedin}
              class="inline-flex items-center gap-2 font-display text-xs font-bold tracking-widest uppercase text-butik-dark hover:text-butik-red transition-colors"
              aria-label={`Profilo LinkedIn di ${f.name}`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
              LinkedIn
            </a>
            <a
              href={`mailto:${f.email}`}
              class="font-sans text-sm text-butik-dark/70 underline hover:text-butik-red transition-colors break-all"
            >
              {f.email}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Testimonianza in evidenza (Cult Funding) -->
  <section class="bg-butik-dark text-white py-16 md:py-20">
    <figure class="max-w-3xl mx-auto px-6 text-center">
      <svg class="w-10 h-10 mx-auto text-butik-red mb-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
      </svg>
      <blockquote class="font-heading text-xl md:text-2xl font-bold leading-snug">
        {c.testimonialQuote}
      </blockquote>
      <figcaption class="font-sans text-sm text-white/70 mt-6">
        {c.testimonialAuthor}
      </figcaption>
    </figure>
  </section>

  <!-- Testimonianze -->
  <Testimonials />

  <!-- CTA finale -->
  <CtaBanner
    title={c.ctaTitle}
    body={c.ctaBody}
    primaryCta={{ label: c.ctaLabel, href: c.ctaHref }}
  />
</BaseLayout>
