---
// Privacy & Cookie Policy — content-driven via Sitepins (ADR-0004). A
// differenza delle altre pagine di `pagine` (frontmatter-only), questa è
// prosa lunga senza struttura ricorrente: il corpo vive nel body Markdown
// dell'entry (stessa forma di `progetti`), non in campi frontmatter separati.
// Il frontmatter resta minimo: meta + il pezzo che il layout interpola fuori
// dal flusso di prosa (titolo H1, data aggiornamento).
import { getEntry, render } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';

const entry = await getEntry('pagine', 'privacy');
if (!entry || entry.data.type !== 'privacy') {
  throw new Error('Contenuto pagina "privacy" mancante o non valido (collezione pagine).');
}
const c = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <article class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <div class="prose prose-lg max-w-none">
      <h1>{c.pageTitle}</h1>
      <p><em>Ultimo aggiornamento: {c.updatedDate}.</em></p>
      <Content />
    </div>
  </article>
</BaseLayout>
