---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import VariantSwitcher from '#components/serviziHero/VariantSwitcher.astro';

export async function getStaticPaths() {
  const servizi = await getCollection('servizi', e => !e.data.draft);
  return servizi.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  heroImage={entry.data.heroImage}
  heroAlt={entry.data.heroAlt}
  metaTitle={entry.data.metaTitle}
  metaDescription={entry.data.metaDescription}
  ogImage={entry.data.ogImage?.src}
  transitionName={`servizio-${entry.id}`}
>
  <Content />
  <div class="not-prose"><VariantSwitcher current="orig" slug={entry.id} /></div>
</ContentLayout>

<span
  id="ph-service-data"
  hidden
  data-slug={entry.id}
  data-title={entry.data.title}
></span>

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('ph-service-data');
    if (!el) return;
    trackEvent('service_viewed', {
      slug: el.dataset.slug,
      title: el.dataset.title,
    });
  });
</script>
