---
import BaseLayout from '#layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CtaBanner from '#components/CtaBanner.astro';
import ServiziPageSwitcher from '#components/serviziCards/ServiziPageSwitcher.astro';

const servizi = (await getCollection('servizi', e => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Copy editoriale della pagina servizi content-driven (ADR-0004): header, intro
// e passi del metodo (array) dalla collezione `pagine` (entry `servizi`). Le
// card servizio restano dalla collezione `servizi`.
const entry = await getEntry('pagine', 'servizi');
if (!entry || entry.data.type !== 'servizi-index') {
  throw new Error('Contenuto pagina "servizi" mancante o non valido (collezione pagine).');
}
const c = entry.data;
const metodo = c.metodo;
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <!-- Page header -->
  <div class="max-w-4xl mx-auto px-6 pt-20 md:pt-24 pb-12 text-center">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">{c.headerEyebrow}</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-6">{c.headerTitle}</h1>
    <p class="font-sans text-base md:text-lg text-butik-body leading-relaxed">
      {c.headerIntro1}
    </p>
    <p class="font-sans text-base md:text-lg text-butik-body leading-relaxed mt-4" set:html={c.headerIntro2}></p>
  </div>

  <!-- Grid -->
  <section class="max-w-7xl mx-auto px-6 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10" data-servizi-grid>
      {servizi.map((s, i) => (
        <a href={`/servizi/${s.id}`} class="group block" data-service-id={s.id} data-service-title={s.data.title} data-service-position={i}>
          <div class="overflow-hidden mb-5">
            <Image
              src={s.data.heroImage}
              alt={s.data.heroAlt}
              widths={[400, 700]}
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
              quality={72}
              loading={i < 3 ? 'eager' : 'lazy'}
              class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500"
              transition:name={`servizio-${s.id}`}
            />
          </div>
          <h2 class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-2" transition:name={`servizio-${s.id}-title`}>
            {s.data.title}
          </h2>
          <p class="font-sans text-base text-butik-body leading-relaxed" transition:name={`servizio-${s.id}-subtitle`}>
            {s.data.subtitle}
          </p>
          <span class="mt-4 inline-block font-display text-xs font-bold tracking-widest uppercase text-butik-dark border-b-2 border-butik-red pb-0.5 group-hover:text-butik-red transition-colors">
            Scopri di più →
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Il nostro metodo -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-10 md:mb-12">
        <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">{c.metodoEyebrow}</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-butik-dark">{c.metodoTitle}</h2>
      </div>
      <ul class="space-y-6">
        {metodo.map((m, i) => (
          <li class="flex gap-4 md:gap-5">
            <span class="inline-flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-butik-red font-display text-sm font-bold text-white">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-1">
              <p class="metodo-title font-heading text-base md:text-lg font-bold text-butik-dark leading-snug">{m.title}</p>
              <p class="font-sans text-sm md:text-base text-butik-dark/70 leading-relaxed mt-1">{m.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA finale -->
  <CtaBanner
    title="Vuoi vedere i nostri servizi in azione?"
    primaryCta={{ label: 'Visiona il nostro portfolio', href: '/progetti' }}
    secondaryCta={{ label: 'Scopri i nostri format', href: '/formats' }}
  />

  <ServiziPageSwitcher current="orig" />
</BaseLayout>

<script>
  import posthog from 'posthog-js';

  function initServiceTracking() {
    const grid = document.querySelector('[data-servizi-grid]');
    if (!grid || (grid as HTMLElement).dataset.phBound) return;
    (grid as HTMLElement).dataset.phBound = 'true';
    grid.addEventListener('click', (e) => {
      const card = (e.target as Element).closest<HTMLAnchorElement>('[data-service-id]');
      if (!card) return;
      posthog.capture('service_card_clicked', {
        service_id: card.dataset.serviceId,
        service_title: card.dataset.serviceTitle,
        position: Number(card.dataset.servicePosition),
      });
    });
  }

  document.addEventListener('astro:page-load', initServiceTracking);
</script>

<style>
  .metodo-title {
    text-transform: none;
    letter-spacing: -0.005em;
    color: var(--color-butik-dark);
  }
</style>
