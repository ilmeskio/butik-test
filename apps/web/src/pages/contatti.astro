---
import { getEntry } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';
import { socials } from '#data/socials';

// Copy editoriale content-driven via collezione `pagine` (ADR-0004): il testo
// attorno al form è editabile da Sitepins. La logica del form Web3Forms qui
// sotto resta invariata.
const entry = await getEntry('pagine', 'contatti');
if (!entry || entry.data.type !== 'contatti') {
  throw new Error('Contenuto pagina "contatti" mancante o non valido (collezione pagine).');
}
const c = entry.data;

// ─────────────────────────────────────────────────────────────────────────────
// Web3Forms access key — letta da variabile d'ambiente, NON committata.
// La key è pubblica (viene inviata dal browser e finisce nel bundle statico):
// non è un segreto, ma la teniamo fuori dal sorgente per non averla nella
// history di git. Il prefisso PUBLIC_ è richiesto da Astro per esporla al client.
//   • Locale → file .env (gitignored):  PUBLIC_WEB3FORMS_ACCESS_KEY=la-tua-key
//   • Deploy → GitHub Secret WEB3FORMS_ACCESS_KEY, iniettato nel build in CI.
// Senza la variabile il form non invia e mostra un messaggio inline.
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
// ─────────────────────────────────────────────────────────────────────────────

const inputClass =
  'w-full border border-butik-dark/20 bg-white px-4 py-3 font-sans text-base text-butik-dark placeholder:text-butik-dark/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-butik-red transition-colors';
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <!-- Header -->
  <div class="max-w-3xl mx-auto px-6 pt-20 md:pt-24 pb-10 text-center">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-4">{c.headerEyebrow}</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-butik-dark mb-5">{c.headerTitle}</h1>
    <p class="font-sans text-base md:text-lg text-butik-body leading-relaxed">
      {c.headerIntro}
    </p>
  </div>

  <section class="max-w-6xl mx-auto px-6 pb-20 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16">
      <!-- Form -->
      <div>
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Nuovo messaggio dal sito wearebutik.com" />
          <input type="hidden" name="from_name" value="Sito Butik" />
          <!-- Honeypot anti-spam Web3Forms: i bot lo compilano, gli umani no. -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div>
            <label for="name" class="block font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-2">
              Nome *
            </label>
            <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} placeholder="Il tuo nome" />
          </div>

          <div>
            <label for="email" class="block font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-2">
              Email *
            </label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} placeholder="nome@esempio.com" />
          </div>

          <div>
            <label for="organizzazione" class="block font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-2">
              Organizzazione / Ente
            </label>
            <input id="organizzazione" name="organizzazione" type="text" autocomplete="organization" class={inputClass} placeholder="Comune, DMO, associazione… (opzionale)" />
          </div>

          <div>
            <label for="message" class="block font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-2">
              Messaggio *
            </label>
            <textarea id="message" name="message" rows="6" required class={inputClass} placeholder="Raccontaci la tua idea o la tua esigenza"></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="w-full md:w-auto bg-butik-dark text-white px-8 py-3 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-red transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Invia messaggio
          </button>

          <p id="form-result" class="font-sans text-sm hidden" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Recapiti -->
      <aside class="lg:border-l lg:border-butik-dark/15 lg:pl-12">
        <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-red mb-6">{c.recapitiEyebrow}</p>

        <div class="space-y-6 font-sans text-base text-butik-body">
          <div>
            <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-1">{c.emailLabel}</p>
            <a href={`mailto:${c.emailValue}`} class="text-butik-dark underline hover:text-butik-red transition-colors">{c.emailValue}</a>
          </div>

          <div>
            <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-1">{c.pecLabel}</p>
            <a href={`mailto:${c.pecValue}`} class="text-butik-dark underline hover:text-butik-red transition-colors">{c.pecValue}</a>
          </div>

          <div>
            <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-1">{c.sedeLabel}</p>
            <address class="not-italic leading-relaxed text-butik-dark/80" set:html={c.sedeAddress}>
            </address>
          </div>

          <div>
            <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-dark mb-2">{c.seguiciLabel}</p>
            <ul class="flex items-center gap-4">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="text-butik-dark hover:text-butik-red transition-colors inline-block"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={s.path} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Aggancia il form. Idempotente: con ClientRouter astro:page-load rifà girare
  // questa init ad ogni navigazione, ma il binding avviene una volta per elemento.
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    const result = document.getElementById('form-result');
    const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
    if (!result || !submit) return;
    form.dataset.bound = 'true';

    const showMessage = (text: string, ok: boolean) => {
      result.textContent = text;
      result.classList.remove('hidden');
      result.classList.toggle('text-butik-red', !ok);
      result.classList.toggle('text-butik-dark', ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
      if (!accessKey) {
        showMessage('Form non ancora configurato: manca la access key di Web3Forms. Scrivici intanto a info@wearebutik.com.', false);
        return;
      }

      submit.disabled = true;
      const originalLabel = submit.textContent;
      submit.textContent = 'Invio in corso…';

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });
        const data = await response.json();

        if (response.ok && data.success) {
          form.reset();
          showMessage('Grazie! Il tuo messaggio è stato inviato. Ti risponderemo al più presto.', true);
        } else {
          showMessage(data.message || 'Qualcosa è andato storto. Riprova o scrivici a info@wearebutik.com.', false);
        }
      } catch {
        showMessage('Errore di rete. Riprova o scrivici a info@wearebutik.com.', false);
      } finally {
        submit.disabled = false;
        submit.textContent = originalLabel;
      }
    });
  }

  // astro:page-load gira al primo caricamento e dopo ogni navigazione ClientRouter.
  document.addEventListener('astro:page-load', initContactForm);
</script>
