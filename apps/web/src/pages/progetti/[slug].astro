---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import ImageBlock from '#components/mdx/ImageBlock.astro';
import ImageCarousel from '#components/mdx/ImageCarousel.astro';
import ImageLeft from '#components/mdx/ImageLeft.astro';
import ImageRight from '#components/mdx/ImageRight.astro';

export async function getStaticPaths() {
  const progetti = await getCollection('progetti', e => !e.data.draft);
  return progetti.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  heroImage={entry.data.heroImage}
  heroAlt={entry.data.heroAlt}
  metaTitle={entry.data.metaTitle}
  metaDescription={entry.data.metaDescription}
  ogImage={entry.data.ogImage?.src}
  transitionName={`progetto-${entry.id}`}
  client={entry.data.client}
  year={entry.data.year}
  category={entry.data.category}
>
  <Content components={{ ImageBlock, ImageCarousel, ImageLeft, ImageRight }} />
</ContentLayout>

<span
  id="ph-project-data"
  hidden
  data-slug={entry.id}
  data-title={entry.data.title}
  data-category={entry.data.category ?? ''}
></span>

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('ph-project-data');
    if (!el) return;
    trackEvent('project_viewed', {
      slug: el.dataset.slug,
      title: el.dataset.title,
      category: el.dataset.category || undefined,
    });
  });
</script>
