---
// Termini di utilizzo — content-driven via Sitepins (ADR-0004). Stessa forma
// di privacy.astro (PR #30): prosa lunga senza struttura ricorrente, corpo
// nel body Markdown dell'entry (come `progetti`), frontmatter minimo.
import { getEntry, render } from 'astro:content';
import BaseLayout from '#layouts/BaseLayout.astro';

const entry = await getEntry('pagine', 'termini');
if (!entry || entry.data.type !== 'termini') {
  throw new Error('Contenuto pagina "termini" mancante o non valido (collezione pagine).');
}
const c = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
>
  <article class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <div class="prose prose-lg max-w-none">
      <h1>{c.pageTitle}</h1>
      <p><em>Ultimo aggiornamento: {c.updatedDate}.</em></p>
      <Content />
    </div>
  </article>
</BaseLayout>
