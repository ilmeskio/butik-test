---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  caption?: string;
  height?: string;
}

const { src, alt = '', caption, height = 'h-80 md:h-[500px]' } = Astro.props;
---

<figure class={`my-12 not-prose w-full ${height} overflow-hidden rounded-sm`}>
  {typeof src === 'string' ? (
    <img src={src} alt={alt} class="w-full h-full object-cover" />
  ) : (
    <Image src={src} alt={alt} class="w-full h-full object-cover" widths={[800, 1200, 1600]} sizes="100vw" quality={72} />
  )}
  {caption && (
    <figcaption class="mt-3 text-center text-sm text-butik-body font-sans italic">{caption}</figcaption>
  )}
</figure>
