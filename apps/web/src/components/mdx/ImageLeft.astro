---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveAsset } from '#lib/media';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
const resolved = typeof src === 'string' ? resolveAsset(src) : src;
---

<div class="my-12 grid grid-cols-1 md:grid-cols-2 gap-8 items-center not-prose">
  <figure class="m-0">
    {typeof resolved === 'string' ? (
      <img src={resolved} alt={alt} class="w-full h-auto object-cover rounded-sm" />
    ) : (
      <Image src={resolved} alt={alt} class="w-full h-auto object-cover rounded-sm" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 50vw" quality={72} />
    )}
    {caption && (
      <figcaption class="mt-2 text-center text-sm text-butik-body font-sans italic">{caption}</figcaption>
    )}
  </figure>

  <div class="prose prose-lg max-w-none">
    <slot />
  </div>
</div>
