---
// Copy content-driven (ADR-0004): testo e label arrivano dalla collezione
// `pagine` (entry `home`), passati da index.astro. L'immagine resta asset locale.
import { Image } from 'astro:assets';

import heroHome from '../../assets/hero-home.jpg';

interface Props {
  title: string;
  p1: string;
  p2: string;
  p3: string;
  ctaLabel: string;
  ctaHref: string;
  imageAlt: string;
}

const { title, p1, p2, p3, ctaLabel, ctaHref, imageAlt } = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div class="order-2 md:order-1">
        <h2
          class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-butik-dark leading-tight mb-6"
        >
          {title}
        </h2>

        <p class="font-sans text-base text-butik-dark/80 leading-relaxed mb-4">
          {p1}
        </p>

        <p class="font-sans text-base text-butik-dark/80 leading-relaxed mb-4">
          {p2}
        </p>

        <p class="font-sans text-base text-butik-dark/80 leading-relaxed">
          {p3}
        </p>

        <a
          href={ctaHref}
          class="inline-block bg-butik-dark text-white px-8 py-4 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-red transition-colors w-full md:w-auto text-center mt-8"
        >
          {ctaLabel}
        </a>
      </div>

      <div class="order-1 md:order-2">
        <Image
          src={heroHome}
          alt={imageAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 768px) 100vw, 50vw"
          quality={75}
          class="w-full aspect-[4/3] md:aspect-square object-cover"
        />
      </div>
    </div>
  </div>
</section>
