---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { partners } from '../../data/partners';
import ServiceCard from '../serviziCards/ServiceCard.astro';
import ServiceLauncher from '../serviziCards/ServiceLauncher.astro';
import { serviziCards } from '../../data/serviziCards';

import imgA from '../../assets/servizi/template-servizio/gallery-1.jpg';
import imgB from '../../assets/servizi/template-servizio/img-right.jpg';
import imgC from '../../assets/servizi/template-servizio/hero.jpg';
import imgD from '../../assets/servizi/template-servizio/img-block.jpg';
import imgE from '../../assets/servizi/template-servizio/img-left.jpg';
import imgF from '../../assets/servizi/template-servizio/gallery-3.jpg';
import imgG from '../../assets/servizi/template-servizio/gallery-2.jpg';
import imgH from '../../assets/hero-home.jpg';

// ── Background tiles ────────────────────────────────────────────────────
// Mosaico di immagini absolute che coprono tutto lo sfondo dell'hero.
// Posizione/dimensione in % della section, con sovrapposizioni volute.
// Parallax: ogni tile ha vy (verticale) e vx (orizzontale) differenti.
interface BgTile {
  src: ImageMetadata;
  alt: string;
  /** Style inline per posizionamento iniziale (top/left/width/height in %). */
  pos: string;
  /** Velocità parallax: y per scroll verticale, x per drift orizzontale. */
  vy: number;
  vx: number;
}

const bgTiles: BgTile[] = [
  { src: imgC, alt: 'Itinerario turistico-musicale',     pos: 'top:-5%; left:-3%;  width:42%; height:55%;', vy: 0.22, vx:  0.04 },
  { src: imgA, alt: 'Workshop di co-progettazione',      pos: 'top:-8%; left:32%;  width:36%; height:50%;', vy: 0.10, vx: -0.06 },
  { src: imgB, alt: 'Comunità coinvolta',                pos: 'top:-3%; left:62%;  width:42%; height:48%;', vy: 0.28, vx:  0.05 },
  { src: imgE, alt: 'Formazione e capacity building',    pos: 'top:38%; left:-4%;  width:38%; height:60%;', vy: 0.34, vx: -0.03 },
  { src: imgH, alt: 'Evento culturale Butik',            pos: 'top:42%; left:28%;  width:42%; height:55%;', vy: 0.15, vx:  0.05 },
  { src: imgD, alt: 'Concerto e attivazione',            pos: 'top:40%; left:62%;  width:40%; height:58%;', vy: 0.26, vx: -0.04 },
  { src: imgG, alt: 'Percorso di formazione',            pos: 'top:62%; left:8%;   width:32%; height:42%;', vy: 0.40, vx:  0.08 },
  { src: imgF, alt: 'Mappa turistico-musicale',          pos: 'top:65%; left:55%;  width:35%; height:40%;', vy: 0.18, vx: -0.07 },
];

// ── Card servizi (5) ────────────────────────────────────────────────────
interface ServizioCard {
  title: string;
  href: string;
  description: string;
}

const servizi: ServizioCard[] = [
  { title: 'Progettazione culturale', href: '/servizi/progettazione-culturale', description: 'Progetti che attivano territori e nuove generazioni.' },
  { title: 'Consulenza strategica',   href: '/servizi/consulenza-strategica',   description: 'Patrimonio musicale come asset culturale e turistico.' },
  { title: 'Formazione',              href: '/servizi/formazione-capacity-building', description: 'Percorsi immersivi per operatori e giovani professionisti.' },
  { title: 'Eventi e format',         href: '/servizi/eventi-culturali-musicali',    description: 'Format musicali per attivare comunità e quartieri.' },
  { title: 'Turismo musicale',        href: '/servizi/prodotti-turistico-musicali',  description: 'Prodotti turistici, itinerari e materiali editoriali.' },
];

// Slideshow mobile: 4-5 immagini di sfondo che ruotano
const mobileBackgrounds = [bgTiles[0], bgTiles[2], bgTiles[4], bgTiles[6]];

// ── Prototipo varianti above-the-fold ──────────────────────────────────
// Props opzionali: default = comportamento attuale (la home `/` resta identica).
//   proof: 'none'   → nessuna prova nella fold (attuale)
//          'numbers' → riga di numeri sintetica sotto il sottotitolo
//          'logos'   → striscia di loghi istituzionali nella fold
//   scrim: true     → scrim scuro dietro la colonna di testo (leggibilità)
interface Props {
  proof?: 'none' | 'numbers' | 'logos';
  scrim?: boolean;
  /** Come presentare i 5 servizi nell'hero (default = card attuali).
      'switch' = mostra tutte le presentazioni con un toggle in-page (eval). */
  services?: 'cards' | 'chip' | 'number' | 'tag' | 'icon' | 'list' | 'strip' | 'switch';
}
const { proof = 'none', scrim = false, services = 'cards' } = Astro.props;
const cardVariant = ['chip', 'number', 'tag', 'icon'].includes(services);
// Modalità valutazione: switcher flottante a 2 assi (hero + servizi), tutto
// renderizzato e composto via JS. Default a video = aspetto attuale.
const isEval = services === 'switch';

// Asse "hero" (prova above-the-fold) per lo switcher flottante.
const heroModes: Array<{ id: string; label: string }> = [
  { id: 'attuale', label: 'Attuale' },
  { id: 'a', label: 'A · numeri' },
  { id: 'b', label: 'B · loghi' },
];

// Asse "servizi": presentazioni disponibili.
const svcModes: Array<{ id: 'cards' | 'chip' | 'number' | 'tag' | 'icon' | 'list' | 'strip'; label: string }> = [
  { id: 'cards', label: 'Cards' },
  { id: 'chip', label: 'Chip' },
  { id: 'number', label: 'Numero' },
  { id: 'tag', label: 'Tag' },
  { id: 'icon', label: 'Icona' },
  { id: 'list', label: 'Lista' },
  { id: 'strip', label: 'Strip' },
];

const proofStats = ['Dal 2018', '30+ progetti', '70K+ persone', 'fondi UE · PNRR'];
const proofLogoNames = [
  'Comune di Milano',
  'Comune di Napoli',
  'Università IULM',
  'FIMI',
  'SIAE',
];
const proofLogos = partners.filter((p) => proofLogoNames.includes(p.name));
---

<section
  class="hero hero-minh relative bg-butik-dark overflow-hidden -mt-20"
  data-hero-section
>

  <!-- ── DESKTOP: mosaico full-bleed di immagini con parallax ────────── -->
  <div class="absolute inset-0 hidden md:block" aria-hidden="true">
    {bgTiles.map((tile, i) => (
      <div
        class="hero-tile absolute will-change-transform overflow-hidden"
        style={tile.pos}
        data-tile-vy={tile.vy}
        data-tile-vx={tile.vx}
        data-tile-index={i}
      >
        <Image
          src={tile.src}
          alt=""
          widths={[400, 700, 1000]}
          sizes="(max-width: 768px) 0px, 40vw"
          quality={72}
          loading="eager"
          class="w-full h-full object-cover"
        />
      </div>
    ))}
  </div>

  <!-- ── MOBILE: slideshow di sfondo single-image ────────────────────── -->
  <div class="absolute inset-0 md:hidden" aria-hidden="true">
    {mobileBackgrounds.map((tile, i) => (
      <div
        class:list={[
          'hero-bg-mobile absolute inset-0 transition-opacity duration-1000 ease-in-out',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        data-hero-bg-mobile={i}
      >
        <Image
          src={tile.src}
          alt=""
          widths={[480, 768]}
          sizes="100vw"
          quality={70}
          loading={i === 0 ? 'eager' : 'lazy'}
          class="w-full h-full object-cover"
        />
      </div>
    ))}
  </div>

  <!-- ── Overlay scuro per leggibilità ───────────────────────────────── -->
  <div class="absolute inset-0 bg-butik-dark/55 md:bg-butik-dark/35" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-butik-dark/30 via-transparent to-butik-dark/60" aria-hidden="true"></div>

  <!-- ── Contenuto hero ──────────────────────────────────────────────── -->
  <div class="hero-minh relative h-full flex flex-col">

    <div class="hero-lead flex-1 flex flex-col justify-center max-w-7xl mx-auto px-6 md:px-8 pt-28 md:pt-28 pb-4 md:pb-6 w-full">

      <!-- Titolo + subtitle + CTA primario -->
      <div class="hero-textcol relative text-center max-w-4xl mx-auto">
        {(scrim || isEval) && <div class="hero-scrim" data-hero-scrim hidden={isEval} aria-hidden="true"></div>}
        <h1 class="hero-title relative font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05]">
          Attiviamo territori, comunità e nuove generazioni attraverso la musica
        </h1>
        <p class="hero-subtitle relative font-sans text-base md:text-lg mt-5 max-w-2xl mx-auto">
          Dal 2018 progettiamo cultura, formazione ed esperienze turistiche su base
          musicale, al fianco di Comuni, DMO e operatori culturali.
        </p>

        {(proof === 'numbers' || isEval) && (
          <ul class="hero-proof relative mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2" data-hero-proof="numbers" hidden={isEval}>
            {proofStats.map((s, i) => (
              <li class="flex items-center font-display text-xs font-bold uppercase tracking-widest text-white">
                {i > 0 && <span class="mx-3 text-butik-green" aria-hidden="true">·</span>}
                <span>{s}</span>
              </li>
            ))}
          </ul>
        )}

        {(proof === 'logos' || isEval) && (
          <div class="hero-proof relative mt-6" data-hero-proof="logos" hidden={isEval}>
            <p class="font-display text-[0.625rem] font-bold uppercase tracking-widest text-white/70 mb-3">
              Al fianco di
            </p>
            <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
              {proofLogos.map((p) => (
                <li class="flex items-center">
                  <Image
                    src={p.logo}
                    alt={p.name}
                    height={32}
                    densities={[1, 2]}
                    class="h-8 w-auto object-contain opacity-90 brightness-0 invert"
                    loading="eager"
                  />
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="hero-cta relative mt-8">
          <a
            href="/contatti"
            class="inline-flex items-center justify-center bg-butik-red text-white px-8 py-4 font-display text-xs font-bold tracking-widest uppercase hover:bg-white hover:text-butik-dark transition-colors"
          >
            Inizia un progetto con noi
          </a>
        </div>
      </div>
    </div>

    <!-- 5 card servizi in basso (1 col mobile, 2 col tablet, 5 col desktop) -->
    <div class="relative max-w-7xl mx-auto px-6 md:px-8 pb-6 md:pb-8 w-full">
      {services === 'cards' && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
          {servizi.map((s, i) => (
            <a
              href={s.href}
              class:list={[
                'hero-card group bg-white/95 hover:bg-white backdrop-blur-sm border border-white/20 p-4 md:p-5 transition-all hover:-translate-y-1 hover:shadow-xl flex flex-col gap-2',
                // 5° card: full-width nella terza riga tablet (2 col)
                i === servizi.length - 1 ? 'sm:col-span-2 lg:col-span-1' : '',
              ]}
            >
              <h3 class="hero-card-title font-heading text-base md:text-lg font-bold leading-tight">
                {s.title}
              </h3>
              <p class="hero-card-desc font-sans text-sm text-butik-dark/70 leading-snug flex-1">
                {s.description}
              </p>
            </a>
          ))}
        </div>
      )}

      {cardVariant && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
          {serviziCards.map((c) => (
            <ServiceCard data={c} variant={services as 'chip' | 'number' | 'tag' | 'icon'} />
          ))}
        </div>
      )}

      {services === 'list' && (
        <div class="bg-white/5 backdrop-blur-sm border border-white/15 px-4 md:px-6 py-1 rounded-lg">
          <ServiceLauncher mode="list" tone="onDark" />
        </div>
      )}

      {services === 'strip' && <ServiceLauncher mode="strip" tone="onDark" />}

      {services === 'switch' && (
        <div data-hero-svc>
          <div data-svc-panel="cards">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
              {servizi.map((s, i) => (
                <a
                  href={s.href}
                  class:list={[
                    'hero-card group bg-white/95 hover:bg-white backdrop-blur-sm border border-white/20 p-4 md:p-5 transition-all hover:-translate-y-1 hover:shadow-xl flex flex-col gap-2',
                    i === servizi.length - 1 ? 'sm:col-span-2 lg:col-span-1' : '',
                  ]}
                >
                  <h3 class="hero-card-title font-heading text-base md:text-lg font-bold leading-tight">{s.title}</h3>
                  <p class="hero-card-desc font-sans text-sm text-butik-dark/70 leading-snug flex-1">{s.description}</p>
                </a>
              ))}
            </div>
          </div>

          {(['chip', 'number', 'tag', 'icon'] as const).map((v) => (
            <div data-svc-panel={v} hidden>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
                {serviziCards.map((c) => <ServiceCard data={c} variant={v} />)}
              </div>
            </div>
          ))}

          <div data-svc-panel="list" hidden>
            <div class="bg-white/5 backdrop-blur-sm border border-white/15 px-4 md:px-6 py-1 rounded-lg">
              <ServiceLauncher mode="list" tone="onDark" />
            </div>
          </div>

          <div data-svc-panel="strip" hidden>
            <ServiceLauncher mode="strip" tone="onDark" />
          </div>
        </div>
      )}

      {isEval && (
        <div class="hero-eval" data-hero-eval aria-label="Anteprima varianti home">
          <div class="hero-eval__row">
            <span class="hero-eval__label">Hero</span>
            {heroModes.map((m) => (
              <button type="button" class="hero-eval__btn" data-axis="hero" data-val={m.id}>{m.label}</button>
            ))}
          </div>
          <div class="hero-eval__row">
            <span class="hero-eval__label">Servizi</span>
            {svcModes.map((m) => (
              <button type="button" class="hero-eval__btn" data-axis="svc" data-val={m.id}>{m.label}</button>
            ))}
          </div>
        </div>
      )}

      <div class="text-center mt-4 md:mt-5">
        <a
          href="/servizi"
          class="font-display text-xs font-bold tracking-widest uppercase text-white/90 hover:text-white inline-flex items-center gap-2 underline underline-offset-4 decoration-white/30 hover:decoration-white"
        >
          Esplora tutti i servizi <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Altezza adattiva (issue #7) ──────────────────────────────────────
     Hero a tutta altezza (82vh) solo quando il viewport è abbastanza alto.
     Su viewport bassi (≤760px) il contenuto da solo riempirebbe lo schermo,
     spingendo la striscia partner sotto la fold: qui compattiamo padding,
     titolo e spaziature così i partner risalgono verso la fold. */
  @media (min-width: 768px) {
    .hero-minh {
      min-height: 82vh;
    }
  }
  @media (min-width: 768px) and (max-height: 760px) {
    .hero-minh {
      min-height: 0;
    }
    .hero-lead {
      padding-top: 5.5rem; /* respiro sotto l'header, senza riempire lo schermo */
      padding-bottom: 1.5rem; /* aria tra il bottone CTA e le card */
    }
    .hero-title {
      font-size: 2rem;
      line-height: 1.05;
    }
    .hero-subtitle {
      margin-top: 0.6rem;
    }
    .hero-cta {
      margin-top: 1rem;
    }
    /* Card più compatte: meno padding e font ridotto per liberare verticale. */
    .hero-card {
      padding: 0.75rem 0.9rem;
      gap: 0.35rem;
    }
    .hero-card-title {
      font-size: 1rem;
    }
    .hero-card-desc {
      font-size: 0.75rem;
    }
  }

  .hero-title,
  .hero-subtitle {
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(7, 17, 8, 0.6);
  }
  .hero-subtitle {
    opacity: 0.95;
  }
  /* Scrim dietro la colonna di testo: rende il claim nitido a prescindere
     dalle tessere del mosaico (variante con scrim=true). */
  .hero-scrim {
    position: absolute;
    inset: -1.5rem -8%;
    z-index: 0;
    background: radial-gradient(
      ellipse 75% 80% at center,
      rgba(7, 17, 8, 0.78) 0%,
      rgba(7, 17, 8, 0.55) 45%,
      rgba(7, 17, 8, 0) 80%
    );
    pointer-events: none;
  }
  /* `.flex` vincerebbe su [hidden]: forziamo il nascondiglio del blocco prova. */
  .hero-proof[hidden] {
    display: none !important;
  }
  /* Override global h3 style (uppercase + tracking + red) per i titoli card. */
  .hero-card-title {
    color: var(--color-butik-dark);
    text-transform: none;
    letter-spacing: -0.005em;
  }
  /* Switcher flottante (solo modalità eval): compone Hero × Servizi.
     Discreto in basso a destra, si accende all'hover. */
  .hero-eval {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.6rem 0.7rem;
    background: color-mix(in srgb, var(--color-butik-dark) 90%, transparent);
    border-radius: 1rem;
    box-shadow: 0 6px 24px rgba(7, 17, 8, 0.3);
    opacity: 0.4;
    transition: opacity 160ms ease;
    backdrop-filter: blur(6px);
  }
  .hero-eval:hover,
  .hero-eval:focus-within {
    opacity: 1;
  }
  .hero-eval__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  .hero-eval__label {
    width: 3.5rem;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .hero-eval__btn {
    height: 1.5rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease;
  }
  .hero-eval__btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .hero-eval__btn.is-active {
    background: var(--color-butik-red);
    border-color: var(--color-butik-red);
  }
  .hero-eval__btn:focus-visible {
    outline: 2px solid var(--color-butik-green);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-eval {
      transition: none;
    }
  }
  .hero-tile {
    transition: transform 100ms linear;
    opacity: 0.92;
    /* Mask radiale ampio e molto progressivo: la zona opaca è ampia (immagini
       ben visibili al centro di ciascuna tile) e il fade ai bordi attraversa
       5 stop in maniera "atmosferica" senza salti di luminanza percepibili.
       Niente blur né border-radius: il mask basta a evitare bordi netti. */
    -webkit-mask-image: radial-gradient(
      ellipse 95% 95% at center,
      #000 5%,
      rgba(0, 0, 0, 0.92) 30%,
      rgba(0, 0, 0, 0.6) 55%,
      rgba(0, 0, 0, 0.25) 78%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 95% 95% at center,
      #000 5%,
      rgba(0, 0, 0, 0.92) 30%,
      rgba(0, 0, 0, 0.6) 55%,
      rgba(0, 0, 0, 0.25) 78%,
      transparent 100%
    );
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktopMQ = window.matchMedia('(min-width: 768px)');

  // ── 1. Mobile slideshow (cross-fade ogni 5s) ───────────────────────────
  const mobileBgs = Array.from(
    document.querySelectorAll<HTMLElement>('.hero-bg-mobile[data-hero-bg-mobile]')
  );
  if (mobileBgs.length > 1 && !reducedMotion) {
    let current = 0;
    setInterval(() => {
      mobileBgs[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % mobileBgs.length;
      mobileBgs[current].classList.replace('opacity-0', 'opacity-100');
    }, 5000);
  }

  // ── 2. Parallax desktop (translate X+Y per ogni tile) ──────────────────
  const tiles = Array.from(
    document.querySelectorAll<HTMLElement>('.hero-tile[data-tile-index]')
  );
  const heroSection = document.querySelector<HTMLElement>('[data-hero-section]');

  let ticking = false;
  const updateParallax = () => {
    if (!heroSection || !desktopMQ.matches || reducedMotion) {
      tiles.forEach((t) => { t.style.transform = ''; });
      ticking = false;
      return;
    }
    const rect = heroSection.getBoundingClientRect();
    if (rect.bottom < -50 || rect.top > window.innerHeight + 50) {
      ticking = false;
      return;
    }
    const progress = -rect.top; // px scrollati dentro l'hero
    tiles.forEach((tile) => {
      const vy = parseFloat(tile.dataset.tileVy || '0');
      const vx = parseFloat(tile.dataset.tileVx || '0');
      const ty = (progress * vy).toFixed(2);
      const tx = (progress * vx).toFixed(2);
      tile.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
    });
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(updateParallax);
    }
  };

  if (heroSection && tiles.length) {
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateParallax();
  }
</script>

<script>
  // Switcher flottante a 2 assi (Hero × Servizi) — solo modalità eval.
  function initHeroEval() {
    const ctrl = document.querySelector<HTMLElement>('[data-hero-eval]');
    if (!ctrl) return;
    const KEY_HERO = 'butik-hero-treat';
    const KEY_SVC = 'butik-hero-svc';
    const scrim = document.querySelector<HTMLElement>('[data-hero-scrim]');
    const proofs = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-proof]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-svc-panel]'));
    const btns = Array.from(ctrl.querySelectorAll<HTMLButtonElement>('.hero-eval__btn'));

    const applyHero = (v: string) => {
      if (scrim) scrim.hidden = v === 'attuale';
      proofs.forEach((p) => {
        const show =
          (v === 'a' && p.dataset.heroProof === 'numbers') ||
          (v === 'b' && p.dataset.heroProof === 'logos');
        p.hidden = !show;
      });
      btns
        .filter((b) => b.dataset.axis === 'hero')
        .forEach((b) => b.classList.toggle('is-active', b.dataset.val === v));
    };
    const applySvc = (v: string) => {
      panels.forEach((p) => { p.hidden = p.dataset.svcPanel !== v; });
      btns
        .filter((b) => b.dataset.axis === 'svc')
        .forEach((b) => b.classList.toggle('is-active', b.dataset.val === v));
    };

    applyHero(localStorage.getItem(KEY_HERO) || 'attuale');
    applySvc(localStorage.getItem(KEY_SVC) || 'cards');

    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const val = b.dataset.val || '';
        if (b.dataset.axis === 'hero') {
          localStorage.setItem(KEY_HERO, val);
          applyHero(val);
        } else {
          localStorage.setItem(KEY_SVC, val);
          applySvc(val);
        }
      })
    );
  }
  document.addEventListener('astro:page-load', initHeroEval);
  initHeroEval();
</script>
