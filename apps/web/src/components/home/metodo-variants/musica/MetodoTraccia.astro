---
// ── Studio musica 3 — Timeline = traccia DAW ──────────────────────────────
// Le 5 tappe come una traccia audio in un editor musicale: righello in alto,
// una "clip" per tappa con mini-waveform, playhead che scorre e illumina la
// clip in corso. Pannello scuro (estetica DAW) con accenti verdi/rossi.
import { tappe } from '../../../../data/metodo';
import MetodoIcon from '../../MetodoIcon.astro';

// Altezze barre pseudo-casuali ma stabili (no Math.random in build): pattern fisso.
const heights = [38, 64, 50, 82, 46, 70, 34, 58, 90, 44, 66, 52, 78, 40, 60];
---

<section class="bg-butik-dark py-12 md:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-10 md:mb-14">
      <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-green mb-4">
        Come lavoriamo
      </p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white">
        Il nostro metodo
      </h2>
    </div>

    <div class="daw">
      {/* righello */}
      <div class="daw-ruler" aria-hidden="true">
        {
          tappe.map((_, i) => (
            <span class="daw-tick">
              <em class="font-display">{String(i + 1).padStart(2, '0')}</em>
            </span>
          ))
        }
      </div>

      {/* traccia con clip + playhead */}
      <ol class="daw-track">
        <span class="daw-playhead" aria-hidden="true"></span>
        {
          tappe.map((tappa, i) => (
            <li class="daw-clip" style={`--clip-i:${i}`}>
              <div class="daw-clip-head">
                <span class="daw-clip-ico"><MetodoIcon name={tappa.icon} size={18} /></span>
                <h3 class="daw-clip-title font-display">{tappa.title}</h3>
              </div>
              <div class="daw-wave" aria-hidden="true">
                {
                  heights.map((h) => (
                    <i style={`height:${h}%`}></i>
                  ))
                }
              </div>
            </li>
          ))
        }
      </ol>

      {/* descrizioni allineate alle clip */}
      <div class="daw-descs">
        {
          tappe.map((tappa) => (
            <p class="font-sans text-sm leading-relaxed">{tappa.description}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .daw {
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    padding: 1rem;
  }

  /* righello */
  .daw-ruler {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    padding: 0 0.25rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .daw-tick {
    position: relative;
    height: 1.25rem;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    padding-left: 0.4rem;
  }
  .daw-tick em {
    font-style: normal;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-butik-green);
  }

  /* traccia */
  .daw-track {
    position: relative;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .daw-clip {
    position: relative;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--color-butik-red) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-butik-red) 45%, transparent);
    padding: 0.5rem 0.6rem 0.55rem;
    overflow: hidden;
  }
  .daw-clip-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .daw-clip-ico {
    flex-shrink: 0;
    color: var(--color-butik-green);
    line-height: 0;
  }
  .daw-clip-title {
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #fff;
  }
  /* mini-waveform della clip */
  .daw-wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 2.4rem;
  }
  .daw-wave i {
    flex: 1 1 0;
    min-width: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-butik-green) 75%, transparent);
  }

  /* playhead che scorre e si ripete */
  .daw-playhead {
    position: absolute;
    top: -0.4rem;
    bottom: -0.4rem;
    left: 0;
    width: 2px;
    background: #fff;
    box-shadow: 0 0 8px 1px rgba(255, 255, 255, 0.6);
    z-index: 2;
    animation: daw-play 9s linear infinite;
  }
  .daw-playhead::before {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
  }
  @keyframes daw-play {
    0% { left: 0; }
    100% { left: 100%; }
  }

  /* descrizioni */
  .daw-descs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding: 0 0.25rem;
  }
  .daw-descs p {
    color: rgba(255, 255, 255, 0.7);
  }

  /* ── Mobile: traccia in verticale (clip impilate) ─────────────────────── */
  @media (max-width: 767px) {
    .daw-ruler { display: none; }
    .daw-track {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .daw-playhead {
      top: 0;
      bottom: 0;
      left: 0;
      width: auto;
      right: 0;
      height: 2px;
      animation: daw-play-v 9s linear infinite;
    }
    .daw-playhead::before { display: none; }
    @keyframes daw-play-v {
      0% { top: 0; }
      100% { top: 100%; }
    }
    .daw-descs {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      margin-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .daw-playhead { animation: none; left: 38%; }
  }
</style>
