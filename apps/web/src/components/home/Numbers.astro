---
// Copy content-driven (ADR-0004): metriche e label arrivano dalla collezione
// `pagine` (entry `home`) come array, passate da index.astro.
type Metric = {
  value: string;
  label: string;
};

interface Props {
  butikMetrics: Metric[];
  mmwLabel: string;
  mmwMetrics: Metric[];
}

const { butikMetrics, mmwLabel, mmwMetrics } = Astro.props;
---

<section class="bg-butik-dark text-white py-10 md:py-14" aria-label="Numeri e impatto">
  <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 lg:gap-4 max-w-7xl mx-auto px-6">
    {
      butikMetrics.map((metric) => (
        <div>
          <dt class="sr-only">{metric.label}</dt>
          <dd>
            <span class="block font-heading text-4xl lg:text-5xl font-black text-butik-green leading-none">
              {metric.value}
            </span>
            <span class="block font-sans text-xs lg:text-sm text-white/70 mt-2 leading-snug" aria-hidden="true">
              {metric.label}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-10 lg:mt-16 pt-10 lg:pt-12 border-t border-white/15 max-w-7xl mx-auto px-6">
    <p class="font-display text-xs font-bold tracking-widest uppercase text-butik-green mb-8 text-center">
      {mmwLabel}
    </p>

    <dl class="grid grid-cols-2 gap-6 lg:gap-12 max-w-xl mx-auto text-center">
      {
        mmwMetrics.map((metric) => (
          <div>
            <dt class="sr-only">{metric.label}</dt>
            <dd>
              <span class="block font-heading text-4xl lg:text-5xl font-black text-butik-green leading-none">
                {metric.value}
              </span>
              <span class="block font-sans text-xs lg:text-sm text-white/70 mt-2 leading-snug" aria-hidden="true">
                {metric.label}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
