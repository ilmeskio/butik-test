---
// Card-servizio con 4 varianti di prova above-the-fold:
//   chip   → dato reale come sigillo in basso
//   number → dato reale grande come aggancio in alto
//   tag    → etichetta pubblico in alto + dato in basso
//   icon   → glifo monolinea in alto + dato in basso
import type { ServiceCardData } from '../../data/serviziCards';

interface Props {
  data: ServiceCardData;
  variant: 'chip' | 'number' | 'tag' | 'icon';
}
const { data, variant } = Astro.props;

// Icone monolinea per slug (solo variante "icon"). Geometriche, niente clip-art.
const icons: Record<string, string> = {
  'progettazione-culturale':
    '<path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>',
  'consulenza-strategica':
    '<circle cx="12" cy="12" r="9"/><path d="M9.5 14.5 11 9l4.5-1.5L14 13z"/>',
  'formazione-capacity-building':
    '<path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  'eventi-culturali-musicali':
    '<path d="M4 12v1.5M8 8.5v7M12 5v14M16 9v6M20 11v2.5"/>',
  'prodotti-turistico-musicali':
    '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};
---

<a href={data.href} class="card group">
  {variant === 'tag' && (
    <span class="card__tag">{data.tag}</span>
  )}

  {variant === 'icon' && (
    <svg
      class="card__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icons[data.slug]}
    />
  )}

  {variant === 'number' && (
    <div class="card__stat-lead">
      <span class="card__stat-value">{data.statValue}</span>
      <span class="card__stat-label">{data.statLabel}</span>
    </div>
  )}

  <h3 class="card__title">{data.title}</h3>
  <p class="card__desc">{data.desc}</p>

  {variant === 'chip' && (
    <span class="card__chip">
      <span class="card__chip-mark" aria-hidden="true">◢</span>
      {`${data.statValue} ${data.statLabel}`}
    </span>
  )}

  {(variant === 'tag' || variant === 'icon') && (
    <span class="card__stat-inline">{`${data.statValue} ${data.statLabel}`}</span>
  )}

  <span class="card__go" aria-hidden="true">→</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-butik-dark) 15%, transparent);
    padding: 1.25rem 1.25rem 1.4rem;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(7, 17, 8, 0.12);
    border-color: color-mix(in srgb, var(--color-butik-dark) 30%, transparent);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-butik-red);
    outline-offset: 3px;
  }

  /* Titolo: neutralizza lo stile globale di h3 (rosso/uppercase/tracking). */
  .card__title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-butik-dark);
    margin: 0;
  }
  .card__desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-butik-dark) 70%, transparent);
    flex: 1;
    margin: 0;
  }

  /* Affordance senza costo di spazio: la freccia è fuori dal flusso (angolo)
     e compare solo all'hover/focus. La card intera è il link. */
  .card__go {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-butik-red);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 150ms ease;
  }
  .card:hover .card__go,
  .card:focus-visible .card__go {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .card__go {
      transition: opacity 150ms ease;
      transform: none;
    }
  }

  /* Variante chip ──────────────────────────────────────────────── */
  .card__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    padding: 0.3rem 0.6rem;
    background: color-mix(in srgb, var(--color-butik-red) 10%, transparent);
    color: var(--color-butik-red);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card__chip-mark {
    font-size: 0.6rem;
    line-height: 1;
  }

  /* Variante number ────────────────────────────────────────────── */
  .card__stat-lead {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.15rem;
  }
  .card__stat-value {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 0.95;
    color: var(--color-butik-red);
  }
  .card__stat-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-butik-dark) 60%, transparent);
    margin-top: 0.25rem;
  }

  /* Variante tag ───────────────────────────────────────────────── */
  .card__tag {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-butik-red);
  }

  /* Variante icon ──────────────────────────────────────────────── */
  .card__icon {
    width: 2rem;
    height: 2rem;
    color: var(--color-butik-red);
  }

  /* Stat inline (tag/icon) ─────────────────────────────────────── */
  .card__stat-inline {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-butik-dark) 55%, transparent);
  }
</style>
