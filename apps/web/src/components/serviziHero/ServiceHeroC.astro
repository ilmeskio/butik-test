---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ServiceHeroContent } from '../../data/serviziHero';
import Eyebrow from '@butik/ui/Eyebrow';

interface Props {
  content: ServiceHeroContent;
  image: ImageMetadata | string;
  imageAlt?: string;
}
const { content, image, imageAlt = '' } = Astro.props;

const isMeta = typeof image !== 'string';
const seal = content.proof?.[0];
const { eyebrow, headline, outcomes, ctaPrimary, ctaSecondary } = content;
---

<section class="service-hero-c relative bg-butik-dark overflow-hidden">
  <!-- ── Atmosfera: immagine del servizio come sfondo ─────────────────── -->
  <div class="absolute inset-0" aria-hidden={imageAlt ? undefined : 'true'}>
    {isMeta ? (
      <Image
        src={image as ImageMetadata}
        alt={imageAlt}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        quality={72}
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
    ) : (
      <img
        src={image as string}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
    )}
  </div>

  <!-- ── Overlay scuro a gradiente per contrasto (WCAG AA) ────────────── -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-butik-dark/85 via-butik-dark/45 to-butik-dark/55"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-r from-butik-dark/55 to-transparent"
    aria-hidden="true"
  ></div>

  <!-- ── Contenuto: card-offerta in basso a sinistra (desktop) ────────── -->
  <div
    class="relative h-[60vh] md:h-[70vh] flex items-end md:items-end max-w-7xl mx-auto px-6 md:px-8 pt-28 pb-8 md:pb-12 w-full"
  >
    <div
      class="offer-card relative w-full md:max-w-xl bg-white/95 backdrop-blur-md border border-white/40 shadow-2xl p-6 md:p-8"
    >
      <!-- Sigillo di credibilità sull'angolo -->
      {seal && (
        <div
          class="offer-seal absolute -top-3 right-4 md:-top-4 md:right-6 bg-butik-red text-white px-3 py-1.5 font-display text-[0.65rem] md:text-xs font-bold tracking-widest uppercase shadow-lg flex items-baseline gap-1.5"
        >
          <span class="text-sm md:text-base leading-none">{seal.value}</span>
          <span class="opacity-90 normal-case tracking-normal font-sans font-medium lowercase">{seal.label}</span>
        </div>
      )}

      <!-- 1) Tag "Per [target]" -->
      <Eyebrow>{eyebrow}</Eyebrow>

      <!-- 2) Headline (unico h1 di pagina) -->
      <h1 class="offer-headline font-heading font-bold text-2xl md:text-4xl leading-[1.08] mt-3">
        {headline}
      </h1>

      <!-- 3) Cosa ottieni -->
      <ul class="mt-5 md:mt-6 space-y-2.5">
        {outcomes.map((o) => (
          <li class="flex items-start gap-3 font-sans text-sm md:text-base text-butik-dark/85">
            <span class="text-butik-red font-bold leading-6 shrink-0" aria-hidden="true">✓</span>
            <span class="leading-snug">{o}</span>
          </li>
        ))}
      </ul>

      <!-- 4) Doppia CTA -->
      <div class="mt-6 md:mt-8 flex flex-col sm:flex-row gap-3">
        <a
          href={ctaPrimary.href}
          class="inline-flex items-center justify-center bg-butik-red text-white px-7 py-3.5 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-dark hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-butik-red"
        >
          {ctaPrimary.label}
        </a>
        {ctaSecondary && (
          <a
            href={ctaSecondary.href}
            class="inline-flex items-center justify-center border-2 border-butik-dark text-butik-dark px-7 py-3.5 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-dark hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-butik-dark"
          >
            {ctaSecondary.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* h1 globale è font-heading + butik-dark: qui la card è chiara, quindi
     manteniamo butik-dark ma neutralizziamo eventuale uppercase ereditato. */
  .offer-headline {
    color: var(--color-butik-dark);
    text-transform: none;
    letter-spacing: -0.01em;
  }
</style>
