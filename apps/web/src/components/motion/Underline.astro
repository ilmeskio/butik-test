---
// Sottolineatura che si "disegna" quando entra in vista — accento per i titoli
// o parole chiave. Tratto leggermente irregolare, non una riga dritta.
interface Props {
  color?: 'red' | 'green' | 'dark';
  class?: string;
}
const { color = 'red', class: cls = '' } = Astro.props;
---

<span class:list={['uline', `uline--${color}`, cls]} data-uline>
  <slot />
  <svg class="uline__svg" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true">
    <path d="M2 9 C 60 3, 110 12, 160 7 S 250 4, 298 8" />
  </svg>
</span>

<style>
  .uline {
    position: relative;
    display: inline-block;
  }
  .uline--red { --ul-c: var(--color-butik-red); }
  .uline--green { --ul-c: var(--color-butik-green); }
  .uline--dark { --ul-c: var(--color-butik-dark); }

  .uline__svg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.22em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
  }
  .uline__svg path {
    fill: none;
    stroke: var(--ul-c, var(--color-butik-red));
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    transition: stroke-dashoffset 750ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .uline.is-drawn .uline__svg path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .uline__svg path {
      transition: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  function initUnderline() {
    const els = Array.from(document.querySelectorAll<HTMLElement>('.uline[data-uline]'));
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach((e) => e.classList.add('is-drawn'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-drawn');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.9 }
    );
    els.forEach((e) => { if (!e.classList.contains('is-drawn')) io.observe(e); });
  }
  initUnderline();
  document.addEventListener('astro:page-load', initUnderline);
</script>
