---
// Equalizer animato — barre da visualizzatore audio. Firma musicale del brand.
// Usabile come accento accanto a titoli/eyebrow, in CTA "live", o come divisore.
interface Props {
  bars?: number;
  tone?: 'onLight' | 'onDark' | 'red' | 'green';
  size?: 'sm' | 'md' | 'lg';
  /** 'always' = anima sempre · 'hover' = solo all'hover del contenitore. */
  play?: 'always' | 'hover';
  class?: string;
}
const { bars = 6, tone = 'onDark', size = 'md', play = 'always', class: cls = '' } = Astro.props;
---

<span class:list={['eq', `eq--${tone}`, `eq--${size}`, `eq--${play}`, cls]} aria-hidden="true">
  {Array.from({ length: bars }).map(() => <i></i>)}
</span>

<style>
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.18em;
    height: 1.4em;
  }
  .eq--sm { font-size: 0.75rem; }
  .eq--md { font-size: 1.25rem; }
  .eq--lg { font-size: 2.5rem; }

  .eq i {
    width: 0.18em;
    height: 35%;
    border-radius: 1px;
    background: var(--eq-c, var(--color-butik-green));
  }
  .eq--onDark { --eq-c: var(--color-butik-green); }
  .eq--onLight { --eq-c: var(--color-butik-red); }
  .eq--red { --eq-c: var(--color-butik-red); }
  .eq--green { --eq-c: var(--color-butik-green); }

  /* Durate/ritardi diversi per barra → movimento organico, non sincronizzato. */
  .eq--always i,
  .eq--hover:hover i {
    animation: eq-bounce 0.8s ease-in-out infinite;
  }
  .eq i:nth-child(1) { animation-duration: 0.62s; }
  .eq i:nth-child(2) { animation-duration: 0.94s; animation-delay: -0.2s; }
  .eq i:nth-child(3) { animation-duration: 0.72s; animation-delay: -0.5s; }
  .eq i:nth-child(4) { animation-duration: 1.1s;  animation-delay: -0.1s; }
  .eq i:nth-child(5) { animation-duration: 0.8s;  animation-delay: -0.35s; }
  .eq i:nth-child(6) { animation-duration: 0.66s; animation-delay: -0.15s; }
  .eq i:nth-child(7) { animation-duration: 1.0s;  animation-delay: -0.45s; }
  .eq i:nth-child(8) { animation-duration: 0.88s; animation-delay: -0.25s; }

  @keyframes eq-bounce {
    0%, 100% { height: 22%; }
    50% { height: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eq i { animation: none !important; height: 55%; }
  }
</style>
