---
import { getImage } from 'astro:assets';
import logo from '../assets/logos/bollo-rosso.svg';
import Logo from '@butik/ui/Logo';
import Button from '@butik/ui/Button';

// getImage() (non <Image>) perché il risultato alimenta l'atomo React Logo di
// @butik/ui — vedi ADR-0008 amendment 2026-07-21 sul vincolo immagini Astro
// dentro le isole.
const logoImg = await getImage({ src: logo, width: 45, height: 45 });

const navLinks = [
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/contatti', label: 'Contatti' },
  { href: '/progetti', label: 'Portfolio' },
  { href: '/blog', label: 'Blog' },
  // TEMP — link interno alle varianti in valutazione. Rimuovere prima del lancio.
  { href: '/lab', label: 'Lab' },
];

const ctaHref = '/contatti';
const ctaLabel = 'Lavoriamo insieme';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

{/*
  Header senza JavaScript (ADR-0002, static-first).

  Lo stato "scrolled" della home era gestito da uno <script> che aggiungeva
  data-scrolled e le classi di sfondo. Con <ClientRouter /> quello script gira
  una volta sola per sessione: dopo una view transition il <header> è un nodo
  nuovo, il listener resta agganciato al vecchio nodo staccato dal DOM e
  l'header resta trasparente anche da scrollato (stesso motivo per cui
  l'hamburger smetteva di aprirsi).

  Ora lo stato è CSS puro:
  - il colore è guidato da una scroll-driven animation su --header-solid
    (0 = overlay sull'hero, 1 = solido), custom property registrata e
    ereditata, così i discendenti la leggono senza bisogno di un attributo;
  - il menu mobile è un <details>, disclosure nativa con semantica accessibile.
  Niente stato JS = niente da re-inizializzare a ogni navigazione.
*/}
<header
  id="site-header"
  data-overlay={isHome ? 'true' : 'false'}
  class:list={[
    'site-header sticky top-0 z-50',
    isHome ? '' : 'bg-butik-light border-b border-butik-dark/10',
  ]}
>
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">

    <!-- Left: Logo + Primary Nav -->
    <div class="flex items-center gap-10">
      <a href="/" class="flex-shrink-0 relative z-10">
        <Logo
          src={logoImg.src}
          width={45}
          height={45}
          loading="eager"
          className="site-logo h-[2.8125rem] w-auto"
        />
      </a>
      <nav class="hidden md:flex items-center gap-8" aria-label="Navigazione principale">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`nav-link font-display text-xs font-bold tracking-widest uppercase transition-colors ${
              isActive(link.href)
                ? 'text-butik-red'
                : 'text-butik-dark hover:text-butik-red'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Right: CTA -->
    <span class="hidden md:inline-block">
      <Button href={ctaHref} tone="dark" className="header-cta">{ctaLabel}</Button>
    </span>

    <!-- Mobile menu: <details> nativo, nessun listener -->
    <details id="mobile-menu" class="mobile-nav md:hidden">
      <summary class="mobile-toggle p-3" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="mobile-panel border-t border-butik-dark/10 bg-butik-light">
        <nav class="flex flex-col px-6 py-4 gap-1" aria-label="Navigazione principale mobile">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`font-display text-xs font-bold tracking-widest uppercase py-3 ${
                isActive(link.href) ? 'text-butik-red' : 'text-butik-dark'
              }`}
            >
              {link.label}
            </a>
          ))}
          <Button href={ctaHref} tone="dark" className="w-full mt-3">{ctaLabel}</Button>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  /* --header-solid: 0 sopra l'hero (overlay), 1 da scrollato. Registrata con
     @property perché serve interpolabile (<number>) ed ereditata: una sola
     animazione sull'header, tutti i discendenti la leggono. */
  @property --header-solid {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @keyframes header-scroll {
    to { --header-solid: 1; }
  }

  /* Solo la home è in overlay sopra l'hero. Longhand e non la shorthand
     `animation`: la shorthand azzera animation-timeline e imporrebbe
     duration: 0s, che con una timeline di scroll non funziona. */
  .site-header[data-overlay='true'] {
    animation-name: header-scroll;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root block);
    /* Crossfade legato allo scroll: trasparente fino a 60px, solido a 120px
       (prima erano 60px + una transizione a tempo di 300ms). */
    animation-range: 60px 120px;

    background-color: color-mix(
      in srgb, var(--color-butik-light) calc(var(--header-solid) * 100%), transparent
    );
    border-bottom: 1px solid color-mix(
      in srgb, rgb(7 17 8 / 0.1) calc(var(--header-solid) * 100%), transparent
    );
  }

  /* Fallback: senza scroll-driven animations (oggi Firefox — animation-timeline
     non è ancora Baseline) l'header della home è solido da subito. Si perde
     l'overlay sull'hero, non la leggibilità. */
  @supports not (animation-timeline: scroll(root block)) {
    .site-header[data-overlay='true'] { --header-solid: 1; }
  }

  /* Con motion ridotto niente crossfade progressivo: switch netto alla soglia. */
  @media (prefers-reduced-motion: reduce) {
    .site-header[data-overlay='true'] { animation-timing-function: steps(1, end); }
  }

  /* Elementi interni: interpolano fra la resa chiara (sopra l'hero scuro) e
     quella scura (header solido). Vale a tutti i breakpoint perché l'hero è
     uniformemente scuro anche su desktop. */
  .site-header[data-overlay='true'] .site-logo {
    filter: drop-shadow(0 1px 4px rgb(7 17 8 / calc((1 - var(--header-solid)) * 0.45)));
  }

  .site-header[data-overlay='true'] .nav-link {
    color: color-mix(in srgb, var(--color-butik-dark) calc(var(--header-solid) * 100%), #ffffff);
    text-shadow: 0 1px 4px rgb(7 17 8 / calc((1 - var(--header-solid)) * 0.45));
  }
  .site-header[data-overlay='true'] .nav-link:hover {
    color: var(--color-butik-red);
  }

  .site-header[data-overlay='true'] .mobile-toggle {
    color: color-mix(in srgb, var(--color-butik-dark) calc(var(--header-solid) * 100%), #ffffff);
    filter: drop-shadow(0 1px 4px rgb(7 17 8 / calc((1 - var(--header-solid)) * 0.45)));
  }

  .site-header[data-overlay='true'] .header-cta {
    background-color: color-mix(
      in srgb, var(--color-butik-dark) calc(var(--header-solid) * 100%), rgb(255 255 255 / 0.12)
    );
    color: #ffffff;
    border: 1px solid color-mix(
      in srgb, var(--color-butik-dark) calc(var(--header-solid) * 100%), rgb(255 255 255 / 0.45)
    );
    backdrop-filter: blur(calc((1 - var(--header-solid)) * 4px));
  }
  .site-header[data-overlay='true'] .header-cta:hover {
    background-color: var(--color-butik-red);
    border-color: var(--color-butik-red);
  }

  /* Menu mobile — <details> nativo. Il pannello è in absolute sotto la barra:
     l'header è sticky (quindi posizionato) e fa da containing block. */
  .mobile-nav > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }
  .mobile-nav > summary::-webkit-details-marker { display: none; }
  .mobile-nav > summary::marker { content: ''; }
  .mobile-nav > summary:focus-visible {
    outline: 2px solid var(--color-butik-red);
    outline-offset: 2px;
  }

  .mobile-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
  }
</style>
