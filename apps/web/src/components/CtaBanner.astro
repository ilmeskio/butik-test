---
/*
 * CtaBanner — migrato da Tailwind a CSS Modules + token (ADR-0005 #css-modules).
 * Prima prova del pattern di migrazione: stile co-locato in CtaBanner.module.css,
 * valori dai token semantici di @butik/ui-tokens. Parità visiva mantenuta.
 */
import styles from './CtaBanner.module.css';

interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  body?: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
}

const { title, body, primaryCta, secondaryCta } = Astro.props;
---

<script>
  import { trackEvent } from '#lib/analytics/posthog.client';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-cta-banner] a').forEach((link) => {
      if ((link as HTMLElement).dataset.phBound) return;
      (link as HTMLElement).dataset.phBound = 'true';
      link.addEventListener('click', () => {
        trackEvent('cta_clicked', {
          label: link.textContent?.trim(),
          href: (link as HTMLAnchorElement).href,
        });
      });
    });
  });
</script>

<section class={styles.banner} data-cta-banner>
  <div class={styles.inner}>
    <div class={styles.content}>
      <h2 class={styles.title}>{title}</h2>
      {body && <p class={styles.body}>{body}</p>}
    </div>

    <div class={styles.actions}>
      <a href={primaryCta.href} class={`${styles.cta} ${styles.primary}`}>
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class={`${styles.cta} ${styles.secondary}`}>
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>
