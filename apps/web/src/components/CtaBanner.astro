---
/*
 * CtaBanner — migrato da Tailwind a CSS Modules + token (ADR-0005 #css-modules).
 * Prima prova del pattern di migrazione: stile co-locato in CtaBanner.module.css,
 * valori dai token semantici di @butik/ui-tokens. Parità visiva mantenuta.
 */
import styles from './CtaBanner.module.css';

interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  body?: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
}

const { title, body, primaryCta, secondaryCta } = Astro.props;
---

<section class={styles.banner}>
  <div class={styles.inner}>
    <div class={styles.content}>
      <h2 class={styles.title}>{title}</h2>
      {body && <p class={styles.body}>{body}</p>}
    </div>

    <div class={styles.actions}>
      <a href={primaryCta.href} data-cta-banner data-cta-variant="primary" class={`${styles.cta} ${styles.primary}`}>
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} data-cta-banner data-cta-variant="secondary" class={`${styles.cta} ${styles.secondary}`}>
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>

<script>
  import posthog from 'posthog-js';

  // Uses event delegation so a single listener covers all CtaBanner instances on the page.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('[data-cta-banner]');
    if (!link) return;
    posthog.capture('cta_banner_clicked', {
      label: link.textContent?.trim(),
      href: link.getAttribute('href'),
      variant: link.dataset.ctaVariant,
    });
  });
</script>
