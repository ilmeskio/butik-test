---
interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  body?: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
}

const { title, body, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-10 md:py-14 max-w-7xl mx-auto px-6">
  <div
    class="border border-butik-dark/15 p-6 md:p-8 lg:p-12 bg-white flex flex-col md:flex-row md:items-center md:justify-between gap-6"
  >
    <div class="md:max-w-2xl">
      <h2
        class="font-heading text-2xl md:text-3xl lg:text-4xl font-bold text-butik-dark leading-tight"
      >
        {title}
      </h2>
      {body && (
        <p class="font-sans text-base text-butik-dark/70 mt-3">{body}</p>
      )}
    </div>

    <div class="flex flex-col md:flex-row gap-3 md:gap-3 md:flex-shrink-0">
      <a
        href={primaryCta.href}
        class="inline-block text-center w-full md:w-auto bg-butik-dark text-white px-6 py-3 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-red transition-colors"
      >
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="inline-block text-center w-full md:w-auto border border-butik-dark px-6 py-3 font-display text-xs font-bold tracking-widest uppercase hover:bg-butik-dark hover:text-white transition-colors"
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>
