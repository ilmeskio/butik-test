---
/*
 * CtaBanner — migrato da Tailwind a CSS Modules + token (ADR-0005 #css-modules).
 * Prima prova del pattern di migrazione: stile co-locato in CtaBanner.module.css,
 * valori dai token semantici di @butik/ui-tokens. Parità visiva mantenuta.
 */
import styles from './CtaBanner.module.css';

interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  body?: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
}

const { title, body, primaryCta, secondaryCta } = Astro.props;
---

<section class={styles.banner}>
  <div class={styles.inner}>
    <div class={styles.content}>
      <h2 class={styles.title}>{title}</h2>
      {body && <p class={styles.body}>{body}</p>}
    </div>

    <div class={styles.actions}>
      <a href={primaryCta.href} class={`${styles.cta} ${styles.primary}`} data-cta-label={primaryCta.label} data-cta-type="primary">
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class={`${styles.cta} ${styles.secondary}`} data-cta-label={secondaryCta.label} data-cta-type="secondary">
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>

<script>
  import { captureEvent } from '#lib/analytics/posthog.client';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-cta-label]').forEach((el) => {
      if (el.dataset.ctaBound) return;
      el.dataset.ctaBound = 'true';
      el.addEventListener('click', () => {
        captureEvent('cta_clicked', {
          label: el.dataset.ctaLabel,
          type: el.dataset.ctaType,
          href: el.getAttribute('href') ?? '',
        });
      });
    });
  });
</script>
