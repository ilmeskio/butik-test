---
// "Il nostro metodo" — step numerati, con eventuale paragrafo introduttivo.
// `description` di ogni step è opzionale (il servizio Formazione ha step di
// solo titolo preceduti da un'introduzione).
import Eyebrow from '@butik/ui/Eyebrow';

interface Step {
  title: string;
  description?: string;
}

interface Props {
  steps: Step[];
  intro?: string;
  eyebrow?: string;
}

const { steps, intro, eyebrow = 'Il nostro metodo' } = Astro.props;
---

<section class="not-prose my-10">
  <Eyebrow>{eyebrow}</Eyebrow>
  {intro && (
    <p class="font-sans text-base md:text-lg text-butik-body leading-relaxed mb-6">{intro}</p>
  )}
  <ol class="space-y-6">
    {steps.map((step, i) => (
      <li class="flex gap-4 md:gap-5">
        <span class="inline-flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-butik-red font-display text-sm font-bold text-white">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="pt-1">
          <p class="step-title font-heading text-base md:text-lg font-bold text-butik-dark leading-snug">
            {step.title}
          </p>
          {step.description && (
            <p class="font-sans text-sm md:text-base text-butik-dark/70 leading-relaxed mt-1">
              {step.description}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Neutralizza lo stile globale dei titoli (uppercase/rosso) per i titoli step. */
  .step-title {
    text-transform: none;
    letter-spacing: -0.005em;
    color: var(--color-butik-dark);
  }
</style>
